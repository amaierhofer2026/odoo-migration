<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Stichwörter-Liste im Odoo-11-Wortlaut (Tag Bezeichnung) -->
    <record id="view_tag_list_itk" model="ir.ui.view">
        <field name="name">itk.helpdesk.tag.list</field>
        <field name="model">helpdesk.ticket.tag</field>
        <field name="inherit_id" ref="helpdesk_mgmt.view_helpdesk_ticket_tag_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="string">Tag Bezeichnung</attribute>
            </field>
        </field>
    </record>

    <record id="view_tag_form_itk" model="ir.ui.view">
        <field name="name">itk.helpdesk.tag.form</field>
        <field name="model">helpdesk.ticket.tag</field>
        <field name="inherit_id" ref="helpdesk_mgmt.view_helpdesk_ticket_tag_form"/>
        <field name="arch" type="xml">
            <field name="sequence" position="attributes">
                <attribute name="string">Nummernfolge</attribute>
            </field>
            <field name="color" position="attributes">
                <attribute name="string">Farbe</attribute>
            </field>
        </field>
    </record>
</odoo>
