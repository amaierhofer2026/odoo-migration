<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- ============================================================
         Stage Views — Status (Odoo 11 style)
         ============================================================ -->

    <!-- Stage list view: Status Name, E-Mail-Vorlage, Unbeaufsichtigt -->
    <record id="view_stage_list_itk" model="ir.ui.view">
        <field name="name">itk.helpdesk.stage.list</field>
        <field name="model">helpdesk.ticket.stage</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <list string="Status" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name" string="Status Name"/>
                <field name="mail_template_id" string="E-Mail-Vorlage"/>
                <field name="unattended" string="Unbeaufsichtigt"/>
                <field name="fold" string="Eingeklappt"/>
                <field name="closed" string="Geschlossen"/>
            </list>
        </field>
    </record>

    <!-- Stage form view: Status Name, E-Mail-Vorlage, Unbeaufsichtigt -->
    <record id="view_stage_form_itk" model="ir.ui.view">
        <field name="name">itk.helpdesk.stage.form</field>
        <field name="model">helpdesk.ticket.stage</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form string="Status">
                <header/>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" string="Status Name"/></h1>
                    </div>
                    <group string="Status-Details">
                        <field name="mail_template_id" string="E-Mail-Vorlage"/>
                        <field name="unattended" string="Unbeaufsichtigt"/>
                        <field name="sequence" string="Reihenfolge"/>
                    </group>
                    <group string="Erweiterte Einstellungen">
                        <field name="fold" string="Eingeklappt in Kanban"/>
                        <field name="closed" string="Geschlossen"/>
                        <field name="close_from_portal" string="Im Portal schließbar"/>
                        <field name="team_ids" string="Helpdesk Teams" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Override the OCA stage action to use our list view -->
    <record id="helpdesk_mgmt.helpdesk_ticket_stage_action" model="ir.actions.act_window">
        <field name="view_mode">list,form</field>
    </record>

</odoo>
