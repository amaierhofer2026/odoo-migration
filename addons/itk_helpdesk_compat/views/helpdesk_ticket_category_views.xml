<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- ============================================================
         Window Actions
         ============================================================ -->

    <!-- Main categories: only records without parent_id -->
    <record id="action_category_main" model="ir.actions.act_window">
        <field name="name">Kategorien</field>
        <field name="res_model">helpdesk.ticket.category</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('parent_id', '=', False)]</field>
        <field name="context">{'default_parent_id': False}</field>
        <field name="view_ids" eval="[(5,0,0),
            (0,0,{'view_mode':'list','view_id': ref('view_category_main_list')}),
            (0,0,{'view_mode':'form','view_id': ref('view_category_main_form')}),
        ]"/>
    </record>

    <!-- Subcategories: only records with parent_id, dedicated views -->
    <record id="action_subcategory" model="ir.actions.act_window">
        <field name="name">Unterkategorien</field>
        <field name="res_model">helpdesk.ticket.category</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('parent_id', '!=', False)]</field>
        <field name="view_ids" eval="[(5,0,0),
            (0,0,{'view_mode':'list','view_id': ref('view_subcategory_list')}),
            (0,0,{'view_mode':'form','view_id': ref('view_subcategory_form')}),
        ]"/>
    </record>

    <!-- Priority action -->
    <record id="action_priority" model="ir.actions.act_window">
        <field name="name">Prioritäten</field>
        <field name="res_model">itk.helpdesk.priority</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5,0,0),
            (0,0,{'view_mode':'list','view_id': ref('view_itk_helpdesk_priority_list')}),
            (0,0,{'view_mode':'form','view_id': ref('view_itk_helpdesk_priority_form')}),
        ]"/>
    </record>

    <!-- Help pages placeholder -->
    <record id="action_help_page_placeholder" model="ir.actions.client">
        <field name="name">Hilfeseiten</field>
        <field name="tag">itk_helpdesk_help_pages</field>
    </record>

    <!-- Dynamic subcategory fields action -->
    <record id="action_subcategory_field" model="ir.actions.act_window">
        <field name="name">Zusätzliche Felder</field>
        <field name="res_model">itk.helpdesk.subcategory.field</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="view_ids" eval="[(5,0,0),
            (0,0,{'view_mode':'list','view_id': ref('view_subcategory_field_list')}),
            (0,0,{'view_mode':'form','view_id': ref('view_subcategory_field_form')}),
        ]"/>
    </record>

    <!-- ============================================================
         Category Views — Kategorien (no parent_id)
         ============================================================ -->

    <record id="view_category_main_list" model="ir.ui.view">
        <field name="name">itk.helpdesk.category.main.list</field>
        <field name="model">helpdesk.ticket.category</field>
        <field name="mode">primary</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list string="Kategorien" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name" string="Kategorie Name"/>
                <field name="user_ids"
                       string="Zuständige Benutzer"
                       widget="many2many_tags"
                       optional="show"/>
                <field name="show_in_portal" widget="boolean_toggle"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_category_main_form" model="ir.ui.view">
        <field name="name">itk.helpdesk.category.main.form</field>
        <field name="model">helpdesk.ticket.category</field>
        <field name="mode">primary</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="Kategorie">
                <header/>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" string="Kategorie Name"/></h1>
                    </div>
                    <group>
                        <field name="user_ids"
                               string="Zuständige Benutzer"
                               widget="many2many_tags"/>
                        <field name="show_in_portal" widget="boolean_toggle"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================
         Subcategory Views — Unterkategorien (with parent_id)
         ============================================================ -->

    <record id="view_subcategory_list" model="ir.ui.view">
        <field name="name">itk.helpdesk.subcategory.list</field>
        <field name="model">helpdesk.ticket.category</field>
        <field name="mode">primary</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list string="Unterkategorien" editable="bottom">
                <field name="parent_id"
                       string="Oberkategorie"
                       required="1"
                       domain="[('parent_id','=',False)]"/>
                <field name="name" string="Unterkategorie Name"/>
            </list>
        </field>
    </record>

    <record id="view_subcategory_form" model="ir.ui.view">
        <field name="name">itk.helpdesk.subcategory.form</field>
        <field name="model">helpdesk.ticket.category</field>
        <field name="mode">primary</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="Unterkategorie">
                <header/>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" string="Unterkategorie Name"/></h1>
                    </div>
                    <group name="main">
                        <field name="parent_id"
                               string="Oberkategorie"
                               domain="[('parent_id','=',False)]"
                               required="1"/>
                    </group>
                    <group name="additional_fields" string="Zusätzliche Felder">
                        <field name="field_ids"
                               string="Zusätzliche Felder"
                               widget="one2many_list">
                            <list editable="bottom">
                                <field name="name" string="Buchungstext"/>
                                <field name="field_type" string="Typ"/>
                                <field name="required"/>
                                <field name="sequence" widget="handle"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
