<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Add sub_category_id to ticket form (2-step category selection) -->
    <record id="view_helpdesk_ticket_form_inherit" model="ir.ui.view">
        <field name="name">itk.helpdesk.ticket.form.inherit</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id"
               ref="helpdesk_mgmt.view_helpdesk_ticket_form"/>
        <field name="arch" type="xml">
            <!-- Place sub_category_id right after category_id -->
            <field name="category_id" position="after">
                <field name="sub_category_id"
                       string="Unterkategorie"
                       domain="[('parent_id', '=', category_id)]"
                       attrs="{'required': [('category_id', '!=', False)],
                               'invisible': [('category_id', '=', False)]}"/>
            </field>
            <!-- Place priority_id -->
            <field name="priority" position="after">
                <field name="priority_id" string="Priorität"/>
            </field>
        </field>
    </record>

    <!-- 2-step category selection also in search view -->
    <record id="view_helpdesk_ticket_search_inherit" model="ir.ui.view">
        <field name="name">itk.helpdesk.ticket.search.inherit</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id"
               ref="helpdesk_mgmt.view_helpdesk_ticket_search"/>
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="sub_category_id"/>
            </field>
        </field>
    </record>

</odoo>
