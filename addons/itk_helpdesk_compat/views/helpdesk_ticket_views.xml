<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- ============================================================
         ITK Ticket List View — 8 columns in Odoo 11 order
         ============================================================ -->
    <record id="view_itk_ticket_list" model="ir.ui.view">
        <field name="name">itk.helpdesk.ticket.list</field>
        <field name="model">helpdesk.ticket</field>
        <field name="mode">primary</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <list string="Support Tickets" default_order="number desc">
                <field name="create_date" string="Erstellt am" optional="show"/>
                <field name="number" string="Ticket-Nummer"/>
                <field name="priority_id" string="Priorität"/>
                <field name="user_id" string="Zugewiesener Benutzer"/>
                <field name="partner_name" string="Personenname"/>
                <field name="category_id" string="Kategorie"/>
                <field name="stage_id" string="Status"/>
                <field name="name" string="Betreff"/>
            </list>
        </field>
    </record>

    <!-- ============================================================
         ITK Ticket Search View
         ============================================================ -->
    <record id="view_itk_ticket_search" model="ir.ui.view">
        <field name="name">itk.helpdesk.ticket.search</field>
        <field name="model">helpdesk.ticket</field>
        <field name="mode">primary</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <search>
                <field string="Ticket-Nummer" name="number"
                       filter_domain="['|',('number','ilike',self),('name','ilike',self)]"/>
                <field name="partner_id"/>
                <field name="partner_name"/>
                <field name="partner_email"/>
                <field name="user_id"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="sub_category_id"/>
                <field name="tag_ids"/>
                <field name="stage_id"/>
                <filter string="Unattended Tickets" name="unattended_tickets"
                        domain="[('unattended','=',True)]"/>
                <filter string="Offen" name="open"
                        domain="[('closed','=',False)]"/>
                <separator/>
                <filter string="Archiviert" name="archived"
                        domain="[('active','=',False)]"/>
                <separator/>
                <filter string="Meine Tickets" name="mytickets"
                        domain="[('user_id','=',uid)]"/>
                <group expand="0" string="Gruppieren nach">
                    <filter string="Status" name="group_stage"
                            domain="[]" context="{'group_by':'stage_id'}"/>
                    <filter string="Kategorie" name="group_category"
                            domain="[]" context="{'group_by':'category_id'}"/>
                    <filter string="Zugewiesener Benutzer" name="group_user"
                            domain="[]" context="{'group_by':'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================
         ITK Ticket Form View — Odoo 11 layout, inherit from OCA form
         ============================================================ -->
    <record id="view_itk_ticket_form" model="ir.ui.view">
        <field name="name">itk.helpdesk.ticket.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.ticket_view_form"/>
        <field name="mode">primary</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">

            <!-- Add ITK action buttons to header -->
            <field name="stage_id" position="before">
                <button string="Ticket schließen"
                        name="action_close_ticket"
                        type="object"
                        class="btn-secondary"
                        invisible="stage_id.closed"
                        confirm="Ticket wirklich schließen?"/>
            </field>

            <!-- Add "Ticket schließen" stat button to OCA button_box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button string="Ticket schließen"
                        name="action_close_ticket"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-check"
                        invisible="stage_id.closed"
                        confirm="Ticket wirklich schließen?"/>
            </xpath>

            <!-- Hide OCA star priority -->
            <field name="priority" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>

            <!-- Hide sequence (show only to developers) -->
            <field name="sequence" position="attributes">
                <attribute name="groups">base.group_no_one</attribute>
            </field>

            <!-- Hide duplicate tracking field -->
            <field name="duplicate_tracking_enabled" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>

            <!-- Replace the entire sheet content -->
            <xpath expr="//sheet" position="replace">
                <sheet>
                    <widget name="web_ribbon" title="Archiviert" bg_color="bg-danger"
                            invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button string="Ticket schließen"
                                name="action_close_ticket"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-check"
                                invisible="stage_id.closed"
                                confirm="Ticket wirklich schließen?"/>
                    </div>

                    <!-- Title: ticket number + subject -->
                    <div class="oe_title">
                        <h1><field name="name" string="Betreff"/></h1>
                    </div>

                    <!-- 2-column field layout matching Odoo 11 -->
                    <group name="main">
                        <group name="left">
                            <field name="number" string="Ticket-Nummer"/>
                            <field name="channel_id" string="Kanal"/>
                            <field name="priority_id" string="Priorität"/>
                            <field name="tag_ids"
                                   string="Stichwörter"
                                   widget="many2many_tags"
                                   options="{'no_create_edit': True, 'color_field': 'color'}"/>
                            <field name="category_id" string="Kategorie"/>
                            <field name="sub_category_id"
                                   string="Unterkategorie"
                                   domain="[('parent_id','=',category_id)]"
                                   invisible="not category_id"/>
                            <field name="stage_id" string="Status"/>
                        </group>
                        <group name="right">
                            <field name="user_id"
                                   string="Zugewiesener Benutzer"
                                   widget="many2one_avatar_user"/>
                            <field name="partner_id" string="Partner"/>
                            <field name="partner_name" string="Personenname"/>
                            <field name="partner_email" string="E-Mail"/>
                            <field name="close_comment" string="Abschluss"/>
                            <field name="closed_date" string="Abschlusszeitpunkt"/>
                        </group>
                    </group>

                    <!-- Notebook tabs matching Odoo 11 -->
                    <notebook>
                        <page string="Beschreibung" name="description">
                            <field name="description" widget="html"/>
                        </page>
                        <page string="Zusätzliche Felder" name="extra_fields">
                            <field name="dynamic_field_value_ids"
                                   string="Zusätzliche Felder"
                                   nolabel="1"/>
                        </page>
                        <page string="Dateianhänge" name="attachments">
                            <field name="attachment_ids"
                                   string="Dateianhänge"
                                   widget="many2many_binary"/>
                        </page>
                        <page string="SLA" name="sla">
                            <group>
                                <field name="sla_ids"
                                       string="SLA"
                                       widget="many2many_tags"/>
                            </group>
                        </page>
                        <!-- Timesheets within ticket -->
                        <page string="Zeiterfassung" name="timesheets">
                            <group>
                                <field name="timesheet_ids" nolabel="1">
                                    <list editable="bottom" default_order="date desc">
                                        <field name="date" string="Datum"/>
                                        <field name="employee_id" string="Benutzer"/>
                                        <field name="name" string="Beschreibung"/>
                                        <field name="project_id" string="Projekt"/>
                                        <field name="task_id" string="Aufgabe"/>
                                        <field name="unit_amount" string="Dauer"
                                               widget="float_time" sum="Gesamt"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </xpath>

            <!-- chatter stays from OCA form -->

        </field>
    </record>

    <!-- ============================================================
         Default tree view for dynamic field values (required by form)
         ============================================================ -->
    <record id="view_itk_field_value_tree" model="ir.ui.view">
        <field name="name">itk.helpdesk.subcategory.field.value.tree</field>
        <field name="model">itk.helpdesk.subcategory.field.value</field>
        <field name="mode">primary</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <list>
                <field name="field_id"/>
                <field name="value_display"/>
            </list>
        </field>
    </record>

    <!-- ============================================================
         ITK Support Tickets — Dedicated Action (MUST be after views)
         ============================================================ -->
    <record id="action_itk_support_tickets" model="ir.actions.act_window">
        <field name="name">Support Tickets</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"search_default_unattended_tickets": 1}</field>
        <field name="view_ids" eval="[(5,0,0),
            (0,0,{'view_mode':'list','view_id': ref('view_itk_ticket_list')}),
            (0,0,{'view_mode':'form','view_id': ref('view_itk_ticket_form')}),
        ]"/>
    </record>

</odoo>
