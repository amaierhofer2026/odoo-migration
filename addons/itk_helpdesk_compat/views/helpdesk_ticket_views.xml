<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- ============================================================
         Support-Tickets - Liste in der Spaltenfolge von Odoo 11
         (website.support.ticket tree view)
         ============================================================ -->
    <record id="view_itk_ticket_list" model="ir.ui.view">
        <field name="name">itk.helpdesk.ticket.list</field>
        <field name="model">helpdesk.ticket</field>
        <field name="mode">primary</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <list string="Support-Tickets" default_order="number desc">
                <field name="create_date" string="Erstellt am" optional="show"/>
                <field name="number" string="Ticket-Nummer"/>
                <field name="priority_id" string="Priorität"/>
                <field name="user_id" string="Zugewiesener Benutzer" widget="many2one_avatar_user"/>
                <field name="partner_name" string="Personenname"/>
                <field name="category_id" string="Kategorie"/>
                <field name="stage_id" string="Status" widget="badge"/>
                <field name="name" string="Betreff"/>
                <field name="sub_category_id" string="Unterkategorie" optional="hide"/>
                <field name="partner_id" string="Partner" optional="hide"/>
                <field name="channel_id" string="Kanal" optional="hide"/>
                <field name="sla_deadline" string="SLA-Frist" optional="hide"/>
                <field name="closed_date" string="Abschlusszeitpunkt" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============================================================
         Support-Tickets - Suche
         Odoo 11: Suche nach Ticket-Nummer, Betreff, Stichwörtern,
         Partner; Filter "Unbeaufsichtigte Tickets"; Gruppierung
         nach Kategorie und Benutzer.
         ============================================================ -->
    <record id="view_itk_ticket_search" model="ir.ui.view">
        <field name="name">itk.helpdesk.ticket.search</field>
        <field name="model">helpdesk.ticket</field>
        <field name="mode">primary</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <search>
                <field string="Ticket-Nummer" name="number"
                       filter_domain="['|',('number','ilike',self),('name','ilike',self)]"/>
                <field name="name" string="Betreff"/>
                <field name="tag_ids" string="Stichwörter"/>
                <field name="partner_id" string="Partner"/>
                <field name="partner_name" string="Personenname"/>
                <field name="partner_email" string="E-Mail"/>
                <field name="user_id" string="Zugewiesener Benutzer"/>
                <field name="category_id" string="Kategorie"/>
                <field name="sub_category_id" string="Unterkategorie"/>
                <field name="stage_id" string="Status"/>
                <filter string="Unbeaufsichtigte Tickets" name="unattended_tickets"
                        domain="[('unattended','=',True)]"/>
                <separator/>
                <filter string="Offen" name="open" domain="[('closed','=',False)]"/>
                <filter string="Meine Tickets" name="mytickets" domain="[('user_id','=',uid)]"/>
                <filter string="Archiviert" name="archived" domain="[('active','=',False)]"/>
                <separator/>
                <group expand="0" string="Gruppieren nach">
                    <filter string="Kategorie" name="group_category"
                            domain="[]" context="{'group_by':'category_id'}"/>
                    <filter string="Benutzer" name="group_user"
                            domain="[]" context="{'group_by':'user_id'}"/>
                    <filter string="Status" name="group_stage"
                            domain="[]" context="{'group_by':'stage_id'}"/>
                    <filter string="Partner" name="group_partner"
                            domain="[]" context="{'group_by':'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================
         Support-Tickets - Formular in der Anordnung von Odoo 11
         ============================================================ -->
    <record id="view_itk_ticket_form" model="ir.ui.view">
        <field name="name">itk.helpdesk.ticket.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.ticket_view_form"/>
        <field name="mode">primary</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">

            <!-- OCA-Sterne-Prioritaet ausblenden: ITK nutzt priority_id -->
            <field name="priority" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>

            <!-- OCA-Reihenfolge nur fuer Entwickler -->
            <field name="sequence" position="attributes">
                <attribute name="groups">base.group_no_one</attribute>
            </field>

            <field name="duplicate_tracking_enabled" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>

            <xpath expr="//sheet" position="replace">
                <sheet>
                    <widget name="web_ribbon" title="Archiviert" bg_color="bg-danger"
                            invisible="active"/>

                    <!-- Knoepfe wie Odoo 11 (ohne Genehmigung und Umfrage) -->
                    <div class="d-flex gap-2 mb-3">
                        <button string="Offen / Antworten"
                                name="action_reply_ticket"
                                type="object"
                                class="btn btn-primary"/>
                        <button string="Ticket schliessen"
                                name="action_close_ticket"
                                type="object"
                                class="btn btn-secondary"
                                confirm="Ticket wirklich schliessen?"/>
                    </div>

                    <!-- Betreff als Titel -->
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" string="Betreff"/></h1>
                    </div>

                    <!-- Zwei Spalten wie in Odoo 11 -->
                    <group name="main">
                        <group name="left">
                            <field name="number" string="Ticket-Nummer"/>
                            <field name="channel_id" string="Kanal"/>
                            <field name="priority_id" string="Priorität"/>
                            <field name="tag_ids"
                                   string="Stichwörter"
                                   widget="many2many_tags"
                                   options="{'no_create_edit': True, 'color_field': 'color'}"/>
                            <field name="category_id" string="Kategorie"/>
                            <field name="sub_category_id"
                                   string="Unterkategorie"
                                   domain="[('parent_id','=',category_id)]"
                                   invisible="not category_id"/>
                            <field name="stage_id" string="Status"/>
                        </group>
                        <group name="right">
                            <!-- Team ist ein Odoo-18-Zusatz (Odoo 11 kannte keine Teams);
                                 es steuert SLA und Zuständigkeit und bleibt sichtbar. -->
                            <field name="team_id" string="Team" options="{'always_reload': True}"/>
                            <field name="user_id"
                                   string="Zugewiesener Benutzer"
                                   widget="many2one_avatar_user"/>
                            <field name="partner_id" string="Partner"/>
                            <field name="partner_name" string="Personenname"/>
                            <field name="partner_email" string="E-Mail"/>
                            <field name="support_comment" string="Partner Kommentar"/>
                            <field name="close_comment" string="Kommentar bei Abschluss"/>
                            <field name="closed_date" string="Abschlusszeitpunkt"/>
                            <field name="closed_by_id" string="Geschlossen von"/>
                        </group>
                    </group>

                    <!-- Reiter wie in Odoo 11 -->
                    <notebook>
                        <page string="Beschreibung" name="description">
                            <field name="description" widget="html"/>
                        </page>
                        <page string="Zusätzliche Felder" name="extra_fields">
                            <field name="dynamic_field_value_ids"
                                   string="Extra Details"
                                   nolabel="1"/>
                        </page>
                        <page string="Dateianhänge" name="attachments">
                            <field name="attachment_ids"
                                   string="Media Anhänge"
                                   widget="many2many_binary"/>
                        </page>
                        <page string="SLA" name="sla">
                            <group>
                                <field name="sla_ids" string="SLA" widget="many2many_tags"/>
                                <field name="sla_deadline" string="SLA-Frist"/>
                                <field name="sla_expired" string="SLA überschritten"/>
                            </group>
                        </page>
                        <page string="Zeiterfassung" name="timesheets">
                            <group>
                                <field name="timesheet_ids" nolabel="1">
                                    <list editable="bottom" default_order="date desc">
                                        <field name="date" string="Datum"/>
                                        <field name="employee_id" string="Benutzer"/>
                                        <field name="name" string="Beschreibung"/>
                                        <field name="project_id" string="Projekt"/>
                                        <field name="task_id" string="Aufgabe"/>
                                        <field name="unit_amount" string="Dauer"
                                               widget="float_time" sum="Gesamt"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </xpath>

        </field>
    </record>

    <!-- Standardliste fuer die dynamischen Werte -->
    <record id="view_itk_field_value_tree" model="ir.ui.view">
        <field name="name">itk.helpdesk.subcategory.field.value.tree</field>
        <field name="model">itk.helpdesk.subcategory.field.value</field>
        <field name="mode">primary</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="field_id" string="Buchungstext"/>
                <field name="value_display" string="Wert"/>
            </list>
        </field>
    </record>

    <!-- ============================================================
         Aktion Support-Tickets: Liste, Kanban, Formular
         (Odoo 11: Baum, Kanban, Formular, Grafik; die Grafik ist in
         Odoo 18 ueber Berichtswesen/Pivot abgedeckt)
         ============================================================ -->
    <record id="action_itk_support_tickets" model="ir.actions.act_window">
        <field name="name">Support-Tickets</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">list,kanban,form</field>
        <!-- Odoo 11 zeigte beim Aufruf alle Tickets (kein Vorfilter) -->
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="view_ids" eval="[(5,0,0),
            (0,0,{'view_mode':'list','view_id': ref('view_itk_ticket_list')}),
            (0,0,{'view_mode':'kanban','view_id': ref('helpdesk_mgmt.view_helpdesk_ticket_kanban')}),
            (0,0,{'view_mode':'form','view_id': ref('view_itk_ticket_form')}),
        ]"/>
    </record>

</odoo>
