<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Priority list view -->
    <record id="view_itk_helpdesk_priority_list" model="ir.ui.view">
        <field name="name">itk.helpdesk.priority.list</field>
        <field name="model">itk.helpdesk.priority</field>
        <field name="arch" type="xml">
            <list string="Prioritäten" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color"/>
            </list>
        </field>
    </record>

    <!-- Priority form view -->
    <record id="view_itk_helpdesk_priority_form" model="ir.ui.view">
        <field name="name">itk.helpdesk.priority.form</field>
        <field name="model">itk.helpdesk.priority</field>
        <field name="arch" type="xml">
            <form string="Priorität">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="sequence"/>
                        <field name="color" widget="color"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
