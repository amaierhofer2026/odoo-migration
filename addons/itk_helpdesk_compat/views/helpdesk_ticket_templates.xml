<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="portal_ticket_form_2step"
              inherit_id="helpdesk_mgmt.portal_create_ticket"
              name="ITK 2-Step Category Selection">
        <xpath expr="//select[@id='category']/.." position="replace">
            <div class="form-group mb-3" t-if="main_categories">
                <label class="col-md-3 col-sm-4 control-label" for="category_id">Kategorie</label>
                <div class="col-md-7 col-sm-8">
                    <select class="form-control" id="category_id" name="category_id"
                            t-att-required="ticket_category_id_required">
                        <option value=""/>
                        <t t-foreach="main_categories" t-as="cat">
                            <option t-attf-value="#{cat.id}"
                                    t-att-selected="'selected' if category_id and int(category_id) == cat.id else None">
                                <t t-esc="cat.name"/>
                            </option>
                        </t>
                    </select>
                </div>
            </div>
            <div class="form-group mb-3" t-if="subcategories" id="subcategory_group"
                 t-att-style="'display:none' if not sub_category_id else ''">
                <label class="col-md-3 col-sm-4 control-label" for="sub_category_id">Unterkategorie</label>
                <div class="col-md-7 col-sm-8">
                    <select class="form-control" id="sub_category_id" name="sub_category_id">
                        <option value=""/>
                        <t t-foreach="subcategories" t-as="sub">
                            <option t-attf-value="#{sub.id}"
                                    t-att-data-parent="#{sub.parent_id.id}"
                                    t-att-selected="'selected' if sub_category_id and int(sub_category_id) == sub.id else None">
                                <t t-esc="sub.name"/>
                            </option>
                        </t>
                    </select>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
