<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- ============================================================
         Mail Template: "Neues Ticket bei IT-Kommunal"
         ============================================================ -->
    <record id="mail_template_new_ticket_itk" model="mail.template">
        <field name="name">Neues Ticket bei IT-Kommunal</field>
        <field name="model_id" ref="helpdesk_mgmt.model_helpdesk_ticket"/>
        <field name="subject">Neues Ticket: {{ object.name }}</field>
        <field name="email_from">{{ object.team_id.email or user.company_id.email }}</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="body_html" type="html">
<![CDATA[
<div style="margin:0;padding:0;background-color:#f1f1f1;font-family:Arial,Helvetica,sans-serif">
  <div style="max-width:600px;margin:0 auto;background-color:#ffffff">
    <div style="background-color:#875A7B;padding:20px;text-align:center">
      <h1 style="color:#ffffff;margin:0">Ihr Ticket wurde erstellt</h1>
    </div>
    <div style="padding:20px">
      <p>Guten Tag ${object.partner_id.name},</p>
      <p>vielen Dank für Ihre Anfrage. Wir haben ein Ticket mit folgenden Details erstellt:</p>
      <table style="width:100%;border-collapse:collapse;margin:15px 0">
        <tr>
          <td style="padding:8px;border:1px solid #ddd;background:#f9f9f9;font-weight:bold">Ticket</td>
          <td style="padding:8px;border:1px solid #ddd">${object.name}</td>
        </tr>
        <tr>
          <td style="padding:8px;border:1px solid #ddd;background:#f9f9f9;font-weight:bold">Kategorie</td>
          <td style="padding:8px;border:1px solid #ddd">${object.category_id.name or ''}</td>
        </tr>
        <tr t-if="object.sub_category_id">
          <td style="padding:8px;border:1px solid #ddd;background:#f9f9f9;font-weight:bold">Unterkategorie</td>
          <td style="padding:8px;border:1px solid #ddd">${object.sub_category_id.name}</td>
        </tr>
        <tr>
          <td style="padding:8px;border:1px solid #ddd;background:#f9f9f9;font-weight:bold">Beschreibung</td>
          <td style="padding:8px;border:1px solid #ddd">${object.description or ''}</td>
        </tr>
      </table>
      <p>Wir werden uns schnellstmöglich um Ihr Anliegen kümmern.</p>
      <p>Mit freundlichen Grüßen,<br/>Ihr IT-Kommunal Team</p>
    </div>
  </div>
</div>
]]>
        </field>
    </record>

</odoo>
