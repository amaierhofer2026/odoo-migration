<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Purchase Order -->
    <record id="purchase_order_form_line_number" model="ir.ui.view">
        <field name="name">purchase.order.form.line.number</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='sequence']" position="after">
                <field name="number" string="Line No."/>
            </xpath>
        </field>
    </record>
</odoo>
