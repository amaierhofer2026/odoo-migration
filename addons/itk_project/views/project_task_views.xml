<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
            Aufgabe (project.task): deutsche Bezeichnungen im Odoo-11-Wortlaut,
            Startdatum (itk_date_start) im Formular und in der Liste, Suchfeld fuer
            das Startdatum. Reine Ansichts-/Feldanzeige, keine Datenmigration.
            Prioritaet 99, damit die Regeln zuletzt greifen.
        -->
        <record id="view_task_form_itk_labels" model="ir.ui.view">
            <field name="name">project.task.form (itk_project - deutsche Bezeichnungen, Startdatum)</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="priority">99</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name'][@widget='text']" position="attributes">
                    <attribute name="string">Aufgabentitel</attribute>
                </xpath>
                <xpath expr="//field[@name='stage_id']" position="attributes">
                    <attribute name="string">Stufe</attribute>
                </xpath>
                <xpath expr="//field[@name='user_ids']" position="attributes">
                    <attribute name="string">Zugewiesen an</attribute>
                </xpath>
                <xpath expr="//field[@name='child_ids']" position="attributes">
                    <attribute name="string">Unteraufgaben</attribute>
                </xpath>
                <xpath expr="//field[@name='subtask_count']" position="attributes">
                    <attribute name="string">Anzahl Unteraufgaben</attribute>
                </xpath>
                <xpath expr="//field[@name='closed_subtask_count']" position="attributes">
                    <attribute name="string">Abgeschlossene Unteraufgaben</attribute>
                </xpath>
                <xpath expr="//field[@name='dependent_tasks_count']" position="attributes">
                    <attribute name="string">Blockierte Aufgaben</attribute>
                </xpath>
                <xpath expr="//field[@name='depend_on_ids']" position="attributes">
                    <attribute name="string">Blockiert durch</attribute>
                </xpath>
                <xpath expr="//field[@name='timesheet_ids']" position="attributes">
                    <attribute name="string">Zeiterfassung</attribute>
                </xpath>
                <xpath expr="//field[@name='allow_timesheets']" position="attributes">
                    <attribute name="string">Zeiterfassungen erlauben</attribute>
                </xpath>
                <xpath expr="//field[@name='allow_milestones']" position="attributes">
                    <attribute name="string">Meilensteine</attribute>
                </xpath>
                <xpath expr="//field[@name='allow_task_dependencies']" position="attributes">
                    <attribute name="string">Aufgabenabhängigkeiten</attribute>
                </xpath>
                <xpath expr="//field[@name='analytic_account_active']" position="attributes">
                    <attribute name="string">Aktive Kostenstelle</attribute>
                </xpath>
                <xpath expr="//field[@name='show_time_control']" position="attributes">
                    <attribute name="string">Zeitsteuerung anzeigen</attribute>
                </xpath>
                <xpath expr="//field[@name='encode_uom_in_days']" position="attributes">
                    <attribute name="string">Zeiteinheit in Tagen</attribute>
                </xpath>
                <xpath expr="//field[@name='ticket_count']" position="attributes">
                    <attribute name="string">Tickets</attribute>
                </xpath>
                <xpath expr="//field[@name='recurring_count']" position="attributes">
                    <attribute name="string">Aufgaben in Wiederholung</attribute>
                </xpath>
                <xpath expr="//field[@name='sequence']" position="attributes">
                    <attribute name="string">Nummernfolge</attribute>
                </xpath>
                <xpath expr="//field[@name='active']" position="attributes">
                    <attribute name="string">Aktiv</attribute>
                </xpath>
                <xpath expr="//field[@name='is_timeoff_task']" position="attributes">
                    <attribute name="string">Abwesenheitsaufgabe</attribute>
                </xpath>
                <xpath expr="//field[@name='subtask_allocated_hours']" position="attributes">
                    <attribute name="string">Zugewiesene Zeit der Unteraufgaben</attribute>
                </xpath>
                <xpath expr="//field[@name='subtask_completion_percentage']" position="attributes">
                    <attribute name="string">Unteraufgaben-Fortschritt (%)</attribute>
                </xpath>
                <!-- Startdatum (Odoo-11-Feld date_start) als eigenes Feld nach der Frist -->
                <xpath expr="//div[@id='date_deadline_and_recurring_task']" position="after">
                    <field name="itk_date_start"/>
                </xpath>
                <xpath expr="//button[@name='button_start_work']" position="attributes">
                    <attribute name="string">Arbeit starten</attribute>
                </xpath>
                <xpath expr="//button[@name='button_end_work']" position="attributes">
                    <attribute name="string">Stopp</attribute>
                </xpath>
            </field>
        </record>

        <record id="view_task_list_itk_labels" model="ir.ui.view">
            <field name="name">project.task.list (itk_project - deutsche Bezeichnungen, Startdatum)</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_tree2"/>
            <field name="priority">99</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="attributes">
                    <attribute name="string">Aufgabentitel</attribute>
                </xpath>
                <xpath expr="//field[@name='stage_id']" position="attributes">
                    <attribute name="string">Stufe</attribute>
                </xpath>
                <xpath expr="//field[@name='user_ids']" position="attributes">
                    <attribute name="string">Zugewiesen an</attribute>
                </xpath>
                <xpath expr="//field[@name='sequence']" position="attributes">
                    <attribute name="string">Nummernfolge</attribute>
                </xpath>
                <xpath expr="//field[@name='subtask_count']" position="attributes">
                    <attribute name="string">Anzahl Unteraufgaben</attribute>
                </xpath>
                <xpath expr="//field[@name='closed_subtask_count']" position="attributes">
                    <attribute name="string">Abgeschlossene Unteraufgaben</attribute>
                </xpath>
                <xpath expr="//field[@name='show_time_control']" position="attributes">
                    <attribute name="string">Zeitsteuerung anzeigen</attribute>
                </xpath>
                <xpath expr="//field[@name='allow_milestones']" position="attributes">
                    <attribute name="string">Meilensteine</attribute>
                </xpath>
                <!-- Startdatum als Spalte (abwaehlbar) vor der Frist -->
                <xpath expr="//field[@name='date_deadline']" position="before">
                    <field name="itk_date_start" optional="show"/>
                </xpath>
                <xpath expr="//button[@name='button_start_work']" position="attributes">
                    <attribute name="string">Arbeit starten</attribute>
                </xpath>
                <xpath expr="//button[@name='button_end_work']" position="attributes">
                    <attribute name="string">Stopp</attribute>
                </xpath>
            </field>
        </record>

        <record id="view_task_search_itk_labels" model="ir.ui.view">
            <field name="name">project.task.search (itk_project - Startdatum, deutsche Bezeichnungen)</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_search_form"/>
            <field name="priority">99</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="attributes">
                    <attribute name="string">Aufgabentitel</attribute>
                </xpath>
                <xpath expr="//filter[@name='open_tickets']" position="attributes">
                    <attribute name="string">Offene Tickets</attribute>
                </xpath>
                <xpath expr="//filter[@name='stage']" position="attributes">
                    <attribute name="string">Stufe</attribute>
                </xpath>
                <!-- Startdatum durchsuchbar/filterbar -->
                <xpath expr="//field[@name='stage_id']" position="after">
                    <field name="itk_date_start"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
