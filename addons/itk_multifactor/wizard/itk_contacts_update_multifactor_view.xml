<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="partner_update_population_and_multifactor_confirm_view" model="ir.ui.view">
        <field name="name">res.partner.multifactor.update.confirm.form</field>
        <field name="model">res.partner.multifactor.update.confirm</field>
        <field name="arch" type="xml">
            <form string="Update Population and Multifactor for selected Partners">
                <p class="oe_grey">This update is not reversible.</p>
                <footer>
                    <button string="Update Population and Multifactor" name="partner_update_population_and_multifactor" type="object" default_focus="1" class="btn-primary"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Odoo 18: <act_window> Kurzform entfernt -> vollwertiges ir.actions.act_window Record.
         Kontext-Aktion (frueher src_model + multi + key2) via binding_model_id + binding_type. -->
    <record id="action_partner_update_population_and_multifactor_confirm" model="ir.actions.act_window">
        <field name="name">Update Population and Multifactor for Partners</field>
        <field name="res_model">res.partner.multifactor.update.confirm</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">action</field>
    </record>

</odoo>
