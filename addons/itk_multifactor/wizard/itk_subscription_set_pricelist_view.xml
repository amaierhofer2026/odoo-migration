<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="subscription_set_pricelist_confirm_view" model="ir.ui.view">
        <field name="name">sale.subscription.set.pricelist.confirm.form</field>
        <field name="model">sale.subscription.set.pricelist.confirm</field>
        <field name="arch" type="xml">
            <form string="Set Pricelist for Subscriptions">
                <p class="oe_grey">This update is not reversible.</p>
                <group>
                    <field name="pricelist_id"/>
                </group>
                <footer>
                    <button string="Set Pricelist" name="subscription_set_pricelist" type="object" default_focus="1" class="btn-primary"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Odoo 18: <act_window> Kurzform entfernt -> vollwertiges ir.actions.act_window Record.
         Kontext-Aktion (frueher src_model + multi + key2) via binding_model_id + binding_type. -->
    <record id="action_subscription_set_pricelist_confirm" model="ir.actions.act_window">
        <field name="name">Set Pricelist for Subscriptions</field>
        <field name="res_model">sale.subscription.set.pricelist.confirm</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="itk_subscription.model_sale_subscription"/>
        <field name="binding_type">action</field>
    </record>

</odoo>
