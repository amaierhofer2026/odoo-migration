<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
            Berichtsmenue "Kosten und Erloese": in Odoo 11 unter
            Zeiterfassung/Berichtswesen vorhanden (Aktion 484, Umsatz-Pivot).
            In Odoo 18 fehlt das Menue; die Umsatzfelder liegen im
            Reportmodell timesheets.analysis.report (timesheet_revenues,
            service_revenues, other_revenues, other_costs, margin).
            Die Odoo-18-Berichte (Nach Mitarbeiter/Projekt/Aufgabe,
            Nach Abrechnungsart, Anwesenheit) bleiben unveraendert.
        -->
        <record id="view_timesheet_report_pivot_revenue_itk" model="ir.ui.view">
            <field name="name">timesheets.analysis.report.pivot.itk.kosten_erloese</field>
            <field name="model">timesheets.analysis.report</field>
            <field name="arch" type="xml">
                <pivot string="Kosten und Erloese">
                    <field name="project_id" type="row"/>
                    <field name="task_id" type="row"/>
                    <field name="date" interval="month" type="col"/>
                    <field name="unit_amount" type="measure" string="Stunden"/>
                    <field name="billable_time" type="measure" string="Abrechenbare Zeit"/>
                    <field name="non_billable_time" type="measure" string="Nicht abrechenbare Zeit"/>
                    <field name="amount" string="Kosten"/>
                    <field name="timesheet_revenues" string="Umsatz aus Zeiterfassung"/>
                    <field name="margin" string="Marge"/>
                </pivot>
            </field>
        </record>

        <record id="action_timesheet_kosten_erloese_itk" model="ir.actions.act_window">
            <field name="name">Kosten und Erloese</field>
            <field name="res_model">timesheets.analysis.report</field>
            <field name="view_mode">pivot,list</field>
            <field name="domain">[('project_id', '!=', False)]</field>
            <field name="context">{'search_default_groupby_project': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_empty_folder">Keine Daten vorhanden</p>
                <p>Auswertung der Zeiterfassung nach Projekt und Monat mit
                   Umsatz, Kosten und Marge.</p>
            </field>
        </record>

        <menuitem id="menu_timesheet_kosten_erloese_itk"
                  name="Kosten und Erloese"
                  parent="hr_timesheet.menu_timesheets_reports"
                  action="action_timesheet_kosten_erloese_itk"
                  sequence="50"/>

        <!-- Menue- und Berichtswortlaute im Odoo-11-Wortlaut -->
        <record id="hr_timesheet.act_hr_timesheet_line" model="ir.actions.act_window">
            <field name="name">Meine Stundenzettel</field>
        </record>

        <record id="hr_timesheet.timesheet_menu_activity_mine" model="ir.ui.menu">
            <field name="name">Meine Stundenzettel</field>
        </record>

        <record id="sale_timesheet.menu_timesheet_billing_analysis" model="ir.ui.menu">
            <field name="name">Nach Abrechnungsrate</field>
        </record>

        <record id="hr_timesheet_attendance.menu_hr_timesheet_attendance_report" model="ir.ui.menu">
            <field name="name">Anwesenheit</field>
        </record>

    </data>
</odoo>
