<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Define actions for ITK menus -->
    <record id="action_all_customers" model="ir.actions.act_window">
        <field name="name">All customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('customer_rank', '&gt;', 0)]</field>
        <field name="context">{'default_customer_rank': 1}</field>
        <field name="limit">80</field>
    </record>

    <record id="action_all_actual_customers" model="ir.actions.act_window">
        <field name="name">Actual customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('customer_rank', '&gt;', 0), ('status_of_partner_id', '=', 'Bestandskunde')]</field>
        <field name="context">{'default_customer_rank': 1}</field>
        <field name="limit">80</field>
    </record>

    <record id="action_all_former_customers" model="ir.actions.act_window">
        <field name="name">Former Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('customer_rank', '&gt;', 0), ('status_of_partner_id', '=', 'Ehemaliger Kunde')]</field>
        <field name="context">{'default_customer_rank': 1}</field>
        <field name="limit">80</field>
    </record>

    <record id="action_all_target_customers" model="ir.actions.act_window">
        <field name="name">Target Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('customer_rank', '&gt;', 0), ('status_of_partner_id', '=', 'Kein Kunde')]</field>
        <field name="context">{'default_customer_rank': 1}</field>
        <field name="limit">80</field>
    </record>

    <record id="action_all_resellers" model="ir.actions.act_window">
        <field name="name">All Resellers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('reseller', '=', True)]</field>
        <field name="context">{'default_customer_rank': 1}</field>
        <field name="limit">80</field>
    </record>

    <record id="action_all_magnitudes" model="ir.actions.act_window">
        <field name="name">All Magnitudes</field>
        <field name="res_model">itk_crm.communitymagnitude</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="limit">80</field>
    </record>

    <!-- 2. Create the menu structure -->
    <menuitem id="menu_itk_toplevel"
              name="ITK-Menu"/>

    <menuitem id="menu_itk_partner"
              parent="menu_itk_toplevel"
              name="Partner"/>

    <menuitem id="menu_itk_reseller"
              parent="menu_itk_toplevel"
              name="Reseller"/>

    <!-- 3. Refer to actions in menu -->
    <menuitem id="menu_all_customers"
              parent="menu_itk_partner"
              action="action_all_customers"
              sequence="20"/>

    <menuitem id="menu_all_actual_customers"
              parent="menu_itk_partner"
              action="action_all_actual_customers"
              sequence="10"/>

    <menuitem id="menu_all_former_customers"
              parent="menu_itk_partner"
              action="action_all_former_customers"
              sequence="10"/>

    <menuitem id="menu_all_target_customers"
              parent="menu_itk_partner"
              action="action_all_target_customers"
              sequence="10"/>

    <menuitem id="menu_all_resellers"
              parent="menu_itk_reseller"
              action="action_all_resellers"
              sequence="10"/>

    <menuitem id="menu_all_magnitudes"
              parent="menu_itk_reseller"
              action="action_all_magnitudes"
              sequence="10"/>

</odoo>
