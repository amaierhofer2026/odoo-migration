        <!-- Tree-View -->
        <record id="view_product_template_tree_itk" model="ir.ui.view">
            <field name="name">Product Template Tree ITK</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='type']" position="replace">
                    <field name="type" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='categ_id']" position="before">
                    <field name="product_type_id" string="Status"/>
                </xpath>
            </field>
        </record>
        <!-- Form-View -->
        <record id="view_product_template_form_itk" model="ir.ui.view">
            <field name="name">Product Template ITK</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='type']" position="replace">
                    <field name="type" invisible="1"/>
                </xpath>
                <xpath expr="//group[@name='group_general']/field[last()]" position="after">
                    <group string="Product-Typ" name="product_type">
                        <field name="product_type_id"/>
                    </group>
                </xpath>
                <!-- 22.09.2026 (Teil 14): to_multiply_by_factor aus dem Formular entfernt.
                     Das Feld hat keine Logik (0 Verwendungen im Code, kein Schreibzugriff)
                     und ist das unbenutzte Duplikat von is_multi_factor_product
                     (itk_multifactor). Das Feld bleibt in der Datenbank, es werden keine
                     Daten geaendert. -->
                <!-- 24.09.2026 (Session 120, Teil 15): "Verantwortlich" neben dem Produkttyp
                     sichtbar machen. In Odoo 11 stand das Feld im Reiter "Lager", der in beiden
                     Versionen bei Dienstleistungen ausgeblendet ist - deshalb hier im ersten
                     Reiter, damit der Wert auch beim Abonnement Produkt sichtbar und pflegbar ist. -->
                <xpath expr="//group[@name='product_type']" position="after">
                    <group name="itk_responsible">
                        <field name="responsible_id"/>
                    </group>
                </xpath>
                <!-- 24.09.2026 (Session 120, Teil 15): sichtbarer Wortlaut wie in Odoo 11
                     ("Notizen" statt "Interne Notizen"). Inhalt unveraendert - die Feldgruppe
                     enthaelt weiterhin das Beschreibungsfeld; Odoo-18-Zusatzfunktionen der
                     Gruppe werden nicht entfernt. Quelle steht im Modul, damit ein Upgrade
                     die Beschriftung nicht zuruecksetzt. -->
                <xpath expr="//group[@name='internal_notes']" position="attributes">
                    <attribute name="string">Notizen</attribute>
                </xpath>
            </field>
        </record>


    </data>
</odoo>