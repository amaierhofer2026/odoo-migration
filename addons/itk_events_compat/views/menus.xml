<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Menues im Odoo-11-Wortlaut
         Odoo 11: App "Events" mit "Events", "Berichtswesen"
         (Events, Fragestellungen) und "Konfiguration"
         (Einstellungen, Anlasskategorien).
         Odoo 18: "Veranstaltungen" mit "Veranstaltungen",
         "Berichtswesen" (Teilnehmer) und "Konfiguration"
         (Veranstaltungsvorlagen, Veranstaltungsphasen, Mailplaner,
         Stichwortkategorien).
         Die Odoo-18-Eintraege bleiben erhalten; die Odoo-11-Namen
         werden gesetzt und "Berichtswesen > Events" ergaenzt.
         "Fragestellungen" entfaellt: Odoo 11 hatte 0 Fragen.
         ================================================================ -->

    <record id="event.event_main_menu" model="ir.ui.menu">
        <field name="name">Events</field>
    </record>

    <record id="event.menu_event_event" model="ir.ui.menu">
        <field name="name">Events</field>
        <field name="sequence">10</field>
    </record>

    <record id="event.menu_reporting_events" model="ir.ui.menu">
        <field name="name">Berichtswesen</field>
        <field name="sequence">99</field>
    </record>

    <record id="event.menu_event_configuration" model="ir.ui.menu">
        <field name="name">Konfiguration</field>
        <field name="sequence">100</field>
    </record>

    <record id="event.menu_event_type" model="ir.ui.menu">
        <field name="name">Anlasskategorien</field>
        <field name="sequence">10</field>
    </record>

    <menuitem id="menu_report_event_itk_events"
              name="Events"
              parent="event.menu_reporting_events"
              action="action_event_report_itk_events"
              sequence="3"/>

</odoo>
