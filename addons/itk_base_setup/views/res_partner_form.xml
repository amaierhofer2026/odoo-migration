<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
            Formularansicht res.partner: Odoo-11-Layout und -Bezeichnungen.
            Erbt vom ITK-CRM-View und passt Felder/Labels an.
        -->
        <record id="view_partner_form_itk_base" model="ir.ui.view">
            <field name="name">res.partner.form (itk_base_setup)</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="priority">90</field>
            <field name="arch" type="xml">

                <!-- 1. "Characteristics" → "Kenndaten" -->
                <xpath expr="//group[@name='group_1']" position="attributes">
                    <attribute name="string">Kenndaten</attribute>
                </xpath>

                <!-- 2. Kenndaten-Spalten exakt nach der sichtbaren Odoo-11-Vorlage:
                     links  = GKZ, Multiplication Factor/Thsd, zu Handen, Organisationsbezeichnung
                     rechts = Verkäufer, Ist ein Lieferant, Ist ein Kunde, Status -->
                <xpath expr="//group[@name='group_1']//group[@name='group_1_left']//field[@name='ref']" position="after">
                    <field name="multi_factor" invisible="not is_company" string="Multiplication Factor/Thsd"/>
                </xpath>
                <xpath expr="//group[@name='group_1']//group[@name='group_1_left']//field[@name='multi_factor']" position="after">
                    <field name="community_salutation" position="move"/>
                </xpath>
                <xpath expr="//group[@name='group_1']//group[@name='group_1_left']//field[@name='multi_factor']" position="after">
                    <field name="attention_of" position="move"/>
                </xpath>
                <xpath expr="//group[@name='group_1']//group[@name='group_1_right']//field[@name='user_id']" position="after">
                    <field name="is_supplier"/>
                    <field name="is_customer"/>
                </xpath>

                <!-- 3c. Tab Kontakte & Adressen: Odoo 18 legt neue Kind-Datensaetze mit default_type=other an
                     (Andere Adresse), Odoo 11 mit contact (Kontakt). Fuer ITK soll ein neu angelegter
                     Ansprechpartner ein Kontakt sein -> default_type aus dem Kontext entfernen
                     (Feldstandard ist contact). Session 100. -->
                <xpath expr="//field[@name='child_ids']" position="attributes">
                    <attribute name="context">{'default_parent_id': id, 'default_street': street, 'default_street2': street2, 'default_city': city, 'default_state_id': state_id, 'default_zip': zip, 'default_country_id': country_id, 'default_lang': lang, 'default_user_id': user_id}</attribute>
                </xpath>

                <!-- 4. Feldbezeichnungen ändern (Odoo-11-Wortlaut) -->
                <!-- Beide title-Vorkommen (Adressblock + Kontaktblock) -->
                <xpath expr="//field[@name='title'][@invisible='is_company == True']" position="attributes">
                    <attribute name="string">Titel</attribute>
                </xpath>
                <xpath expr="//field[@name='title'][@invisible=&quot;type != 'contact'&quot;]" position="attributes">
                    <attribute name="string">Titel</attribute>
                </xpath>

                <!-- Beide street2-Vorkommen -->
                <xpath expr="//field[@name='street2'][@readonly=&quot;type == 'contact' and parent_id != False&quot;]" position="attributes">
                    <attribute name="string">Straße 2</attribute>
                </xpath>
                <xpath expr="//field[@name='street2'][not(@readonly)]" position="attributes">
                    <attribute name="string">Straße 2</attribute>
                </xpath>

                <!-- child_ids: Odoo 18 "Kontakt" (Einzahl) -> Odoo 11 "Kontakte" -->
                <xpath expr="//field[@name='child_ids']" position="attributes">
                    <attribute name="string">Kontakte</attribute>
                </xpath>

                <!-- Verkäufer auch im Tab "Verkauf & Einkauf" (dort kam der Kernname "Vertriebsmitarbeiter") -->
                <xpath expr="//page[@name='sales_purchases']//field[@name='user_id']" position="attributes">
                    <attribute name="string">Verkäufer</attribute>
                </xpath>

                <xpath expr="//field[@name='attention_of']" position="attributes">
                    <attribute name="string">zu Handen</attribute>
                </xpath>

                <xpath expr="//field[@name='community_salutation']" position="attributes">
                    <attribute name="string">Organisationsbezeichnung</attribute>
                </xpath>

                <xpath expr="//field[@name='user_id']" position="attributes">
                    <attribute name="string">Verkäufer</attribute>
                </xpath>

                <xpath expr="//field[@name='status_of_partner_id']" position="attributes">
                    <attribute name="string">Status</attribute>
                </xpath>

                <xpath expr="//field[@name='vat']" position="attributes">
                    <attribute name="string">UID</attribute>
                </xpath>

                <xpath expr="//field[@name='official_email']" position="attributes">
                    <attribute name="string">Email offiziell</attribute>
                </xpath>

                <xpath expr="//field[@name='website']" position="attributes">
                    <attribute name="string">Website</attribute>
                </xpath>

                <!-- "Address" Label im Adressblock -->
                <xpath expr="//label[@for='street']" position="attributes">
                    <attribute name="string">Adresse</attribute>
                </xpath>

                <!-- 3b. Adressblock: rechts nur Telefon, Mobil, E-Mail, Website, Sprache
                     (wie Odoo 11); die zusaetzlichen Odoo-18-/ITK-Felder ans Ende. -->
                <xpath expr="//field[@name='lang']" position="after">
                    <field name="official_email" position="move"/>
                </xpath>

                <!-- Titel und akademische Titel stehen in Odoo 11 NICHT im Hauptblock.
                     Session 98: eigene Gruppe UNTERHALB des Adressblocks.
                     WICHTIG: die Gruppe LEER anlegen und die Felder danach mit einem zweiten
                     xpath per position="inside" hineinverschieben. Ein Verschiebe-Platzhalter
                     als Kind der neu eingefuegten Gruppe wird NICHT verschoben, sondern als
                     zusaetzliche Feldkopie eingefuegt (Doppelung). -->
                <xpath expr="//field[@name='vat']/ancestor::group[2]" position="after">
                    <group name="itk_titel_person" string="Titel und akademische Titel" invisible="is_company"/>
                </xpath>
                <xpath expr="//group[@name='itk_titel_person']" position="inside">
                    <field name="title" options="{'no_open': True}" invisible="is_company == True" position="move"/>
                    <field name="title_put_in_front" position="move"/>
                    <field name="title_put_in_back" position="move"/>
                    <field name="academic_title_display" position="move"/>
                    <field name="academic_title_ids" position="move"/>
                </xpath>

                <!-- 4b. Tab Interne Notizen: Wortlaute der Warnabschnitte wie in Odoo 11 (Session 102).
                     Die Abschnitte selbst kommen aus base (Verkauf/Rechnung) und purchase (Einkauf);
                     die Einkaufs-Warnung ist zusaetzlich an die Einstellung purchase.group_warning_purchase
                     gebunden (in Odoo 18 der Schalter fuer Warnungen) und dort aktiviert. -->
                <xpath expr="//page[@name='internal_notes']//field[@name='sale_warn']/preceding-sibling::separator[1]" position="attributes">
                    <attribute name="string">Alarmierung bei Auftrag</attribute>
                </xpath>
                <xpath expr="//page[@name='internal_notes']//field[@name='purchase_warn']/preceding-sibling::separator[1]" position="attributes">
                    <attribute name="string">Warnung beim Einkaufsauftrag</attribute>
                </xpath>
                <xpath expr="//page[@name='internal_notes']//field[@name='comment']" position="attributes">
                    <attribute name="placeholder">Interner Hinweis ...</attribute>
                </xpath>

                <!-- 5. Tab-Bezeichnungen an Odoo 11 anpassen -->

                <!-- 5. Tab-Reihenfolge wie Odoo 11: "Interne Notizen" an zweiter Stelle -->
                <xpath expr="//page[@name='contact_addresses']" position="after">
                    <page name="internal_notes" position="move"/>
                </xpath>

                <!-- "Sales &amp; Purchase" → "Verkauf &amp; Einkauf" -->
                <xpath expr="//page[@name='sales_purchases']" position="attributes">
                    <attribute name="string">Verkauf &amp; Einkauf</attribute>
                </xpath>

                <!--
                    Beschriftung "Referenz" → "Interne Referenz" (Odoo 11 Prod, Session 106).
                    In Odoo 11 heisst das Feld "Interne Referenz"; Odoo 18 setzt in der
                    Basis-Ansicht ausdruecklich "Referenz". Feld und Inhalt bleiben unveraendert.
                    Die GKZ-Beschriftung im Kenndatenblock und in der Liste bleibt wie bisher.
                -->
                <xpath expr="//page[@name='sales_purchases']//field[@name='ref']" position="attributes">
                    <attribute name="string">Interne Referenz</attribute>
                </xpath>

                <!-- "Invoicing" → "Abrechnung" -->
                <xpath expr="//page[@name='accounting']" position="attributes">
                    <attribute name="string">Abrechnung</attribute>
                </xpath>

                <!--
                     Community-Information-Page-Umbennung erfolgt direkt
                     im itk_crm-View (name-Attribut dort ergaenzt).
                     Der Tab-String wird dort auf "Gemeinde-Information" gesetzt.
                -->

                <!--
                    6b. Reiter Gemeinde-Information: Organisationstyp vollstaendig lesbar (Session 110).
                    Die Spalte war nur 26 px breit, der Wert wurde abgeschnitten (z. B. "Marktgemeinde",
                    "Magistrat der Stadt"). Das Feld spannt jetzt beide Spalten der Gruppe "Andere" und
                    bekommt damit die volle Gruppenbreite. Nur diese View/Feldbreite, keine globale UI-Aenderung.
                -->
                <!-- Die Gruppe "Andere" liegt doppelt verschachtelt und bekam dadurch nur ein Viertel der
                     Reiterbreite (230 px). Dadurch war die Feldspalte nur 50 px breit und der Wert wurde
                     abgeschnitten. colspan=2 auf der Gruppe gibt ihr die volle halbe Reiterbreite. -->
                <xpath expr="//page[@name='community_info']//group[@name='other']" position="attributes">
                    <attribute name="colspan">2</attribute>
                </xpath>
                <xpath expr="//page[@name='community_info']//field[@name='status_of_community']" position="attributes">
                    <attribute name="colspan">2</attribute>
                </xpath>

                <!-- 6. Community-Info Feldbezeichnungen direkt in itk_crm/views/res_partner.xml -->

            </field>
        </record>

        <!--
            Smart-Button-Bezeichnungen und Support-Ticket-Tab.
            Erbt direkt von base.view_partner_form (nicht von itk_crm),
            damit die von anderen Modulen hinzugefuegten Stat-Buttons 
            (Sale, Invoiced, Subscriptions etc.) im XPath gefunden werden.
        -->
        <record id="view_partner_smart_buttons" model="ir.ui.view">
            <field name="name">res.partner.form (itk_base_setup smart buttons)</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="priority">91</field>
            <field name="arch" type="xml">

                <!-- "Sales" → "Verkauf" -->
                <xpath expr="//field[@name='sale_order_count']" position="attributes">
                    <attribute name="string">Verkauf</attribute>
                </xpath>

                <!-- "Invoiced" → "Fakturiert" (span-Text ersetzen) -->
                <xpath expr="//button[@name='action_view_partner_invoices']//span[@class='o_stat_text']" position="replace">
                    <span class="o_stat_text">Fakturiert</span>
                </xpath>

                <!-- "Subscriptions" → "Abonnements" -->
                <xpath expr="//field[@name='subscription_count']" position="attributes">
                    <attribute name="string">Abonnements</attribute>
                </xpath>

                <!-- Smart-Button-Reihenfolge wie Odoo 11: Verkaufschancen, Verkauf, Meetings -->
                <xpath expr="//button[@name='action_view_sale_order']" position="after">
                    <button name="schedule_meeting" position="move"/>
                </xpath>

                <!--
                    Support-Ticket-Tab (Session 112).
                    Odoo 11 zeigte hier Felder des Moduls website_support (SLA je Kontakt, Zugriffskonten) - beide
                    ohne Datenbestand und ohne Odoo-18-Gegenstueck. Odoo 18 nutzt stattdessen die OCA-Helpdesk-Funktion
                    (helpdesk_mgmt): der Kontakt ist ueber helpdesk_ticket_ids mit seinen Tickets verbunden, der
                    Smart-Button "Support Tickets" oeffnet die Liste. Der Reiter zeigt diese Tickets jetzt direkt an
                    (nur lesend, gepflegt werden sie in der Helpdesk-App) statt eines Platzhaltertexts.
                -->
                <xpath expr="//notebook" position="inside">
                    <page string="Support Ticket" name="support_ticket">
                        <field name="helpdesk_ticket_ids" readonly="1" nolabel="1">
                            <list create="false" edit="false" delete="false">
                                <field name="number" string="Ticketnummer"/>
                                <field name="name" string="Titel"/>
                                <field name="create_date" string="Erstellt am"/>
                                <field name="stage_id" string="Stufe"/>
                                <field name="team_id" string="Team"/>
                                <field name="category_id" string="Kategorie"/>
                                <field name="user_id" string="Zugewiesener Benutzer"/>
                            </list>
                        </field>
                    </page>
                </xpath>

                <!-- Odoo 11 nannte den Smart-Button "Support Tickets" -->
                <xpath expr="//button[@name='action_view_helpdesk_tickets']//field[@name='helpdesk_ticket_count_string']" position="attributes">
                    <attribute name="string">Support Tickets</attribute>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
