<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
            Formularansicht sale.subscription.line: Odoo-11-Layout.
            Linke/Rechte Spalte wie im Odoo-11-Screenshot.
        -->
        <record id="view_sale_subscription_line_form_itk" model="ir.ui.view">
            <field name="name">sale.subscription.line.form (itk)</field>
            <field name="model">sale.subscription.line</field>
            <field name="priority">30</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group string="Position">
                                <field name="qty_multiplication_factor" string="Multiplication Factor/Thsd"/>
                                <field name="analytic_account_id" string="Aboauftrag"/>
                                <field name="name" string="Beschreibung"/>
                                <field name="quantity" string="Menge"/>
                                <field name="price_unit" string="Preis pro ME"/>
                                <field name="price_subtotal" string="Zwischensumme"/>
                                <field name="salesperson_id" string="Verkäufer"/>
                            </group>
                            <group string="Details">
                                <field name="product_id" string="Produkt"/>
                                <field name="uom_id" string="Mengeneinheit"/>
                                <field name="discount" string="Rabatt (%)"/>
                                <field name="partner_id" string="Partner"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Form-View in der Action 1451 referenzieren -->
        <record id="action_subscription_lines_partner" model="ir.actions.act_window">
            <field name="name">Abonnements</field>
            <field name="res_model">sale.subscription.line</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('partner_id', '=', active_id)]</field>
            <field name="context">{'group_by': 'analytic_account_id', 'default_partner_id': active_id}</field>
            <field name="view_ids" eval="[(5,0,0),
                (0,0,{'view_mode': 'list', 'view_id': ref('view_sale_subscription_line_list_itk')}),
                (0,0,{'view_mode': 'form', 'view_id': ref('view_sale_subscription_line_form_itk')}),
            ]"/>
        </record>

    </data>
</odoo>
