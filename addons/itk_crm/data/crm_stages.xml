<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate=1: wird nur angelegt, wenn nicht vorhanden; die Namens-/Wert-Konvergenz
         bei jedem Upgrade uebernimmt der post_init_hook (_setup_stage_labels). -->
    <data noupdate="1">
        <!-- Odoo-11-kompatible CRM-Stages (Kundenverwaltung)
             Persistierung der RPC-Arbeit vom 30.07.2026 (Session 6).
             Die 4 Default-Stages werden umbenannt (noupdate=0 -> bei jedem Upgrade
             erneut angewendet), 4 neue Stages kommen mit itk_crm-XML-IDs hinzu.
             Die Name-Übersetzungen (de_DE/en_US) sichert der post_init_hook. -->

        <record id="crm.stage_lead1" model="crm.stage">
            <field name="name">Neu</field>
            <field name="sequence">1</field>
        </record>
        <record id="crm.stage_lead2" model="crm.stage">
            <field name="name">Angebotsphase</field>
            <field name="sequence">2</field>
        </record>
        <record id="crm.stage_lead3" model="crm.stage">
            <field name="name">On-Hold</field>
            <field name="sequence">3</field>
        </record>
        <record id="crm.stage_lead4" model="crm.stage">
            <field name="name">Erfolgreich</field>
            <field name="sequence">5</field>
            <field name="is_won">True</field>
        </record>

        <record id="stage_positive_rueckmeldung" model="crm.stage">
            <field name="name">Positive Rückmeldung</field>
            <field name="sequence">4</field>
        </record>
        <record id="stage_zur_verrechnung" model="crm.stage">
            <field name="name">Zur Verrechnung bereit</field>
            <field name="sequence">6</field>
        </record>
        <record id="stage_verloren" model="crm.stage">
            <field name="name">Verloren</field>
            <field name="sequence">7</field>
            <field name="fold">True</field>
        </record>
        <record id="stage_verrechnet" model="crm.stage">
            <field name="name">Verrechnet</field>
            <field name="sequence">8</field>
            <field name="fold">True</field>
        </record>
    </data>
</odoo>
