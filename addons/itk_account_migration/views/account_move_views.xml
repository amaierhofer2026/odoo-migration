<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Rechnung: Odoo-11-Rechnungsnummer, nur lesbar und nur bei Rechnungen/Gutschriften sichtbar -->
    <record id="view_move_form_itk_o11" model="ir.ui.view">
        <field name="name">account.move.form.itk.o11.nummer</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_info']" position="inside">
                <group name="itk_o11_herkunft" string="Herkunft (Migration)">
                    <label for="itk_o11_invoice_number" string="Odoo-11-Rechnungsnummer"/>
                    <field name="itk_o11_invoice_number" nolabel="1" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_move_tree_itk_o11" model="ir.ui.view">
        <field name="name">account.move.list.itk.o11.nummer</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="itk_o11_invoice_number" optional="hide" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_search_itk_o11" model="ir.ui.view">
        <field name="name">account.move.search.itk.o11.nummer</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="itk_o11_invoice_number" string="Odoo-11-Rechnungsnummer"/>
            </xpath>
        </field>
    </record>

    <!-- Sichtbare Bezeichnungen aus Odoo 11 (Rechnung/Gutschrift) -->
    <record id="view_move_form_itk_o11_texte" model="ir.ui.view">
        <field name="name">account.move.form.itk.o11.texte</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_info']" position="attributes">
                <attribute name="string">Andere Informationen</attribute>
            </xpath>
            <!-- Odoo 11: "Auf Entwurf setzen", "Nach Gutschrift fragen", "Einzahlung erfassen" -->
            <xpath expr="//button[@name='button_draft']" position="attributes">
                <attribute name="string">Auf Entwurf setzen</attribute>
            </xpath>
            <xpath expr="//button[@name='action_reverse']" position="attributes">
                <attribute name="string">Nach Gutschrift fragen</attribute>
            </xpath>
            <xpath expr="//button[@name='action_register_payment']" position="attributes">
                <attribute name="string">Einzahlung erfassen</attribute>
            </xpath>
        </field>
    </record>
</odoo>

