<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Punkt 1 (Session 123/124): Project-Category-Spalte in den Kunden-Rechnungslisten.

         Odoo 11 zeigt die Spalte nur bei Kundenrechnungen und Kunden-Gutschriften; die
         Kundenliste account.invoice.tree (Odoo 11, View 590) fuehrt sie an Position 3,
         direkt nach Nummer und Status:
             <field name="number"/><field name="state"/><field name="projectcategory_id"/>
         Die Lieferantenliste kennt die Spalte nicht.

         In Odoo 18 hat jede Belegart eine eigene Listenansicht, die von
         account.view_invoice_tree erbt:
             account.view_out_invoice_tree       -> Ausgangsrechnungen
             account.view_out_credit_note_tree   -> Kunden-Gutschriften
             account.view_in_invoice_bill_tree   -> Eingangsrechnungen
             account.view_in_invoice_refund_tree -> Lieferanten-Gutschriften
         Deshalb wird die Spalte ausschliesslich in den beiden Kundenansichten ergaenzt,
         jeweils hinter dem Status (status_in_payment = Odoo-11-Feld state). Eingangs- und
         Lieferantenlisten bleiben unveraendert. Es wird nichts ausgeblendet oder entfernt;
         die Spalte ist wie alle Odoo-18-Spalten ueber die Spaltenauswahl abwaehlbar. -->
    <record id="view_out_invoice_tree_itk_pc" model="ir.ui.view">
        <field name="name">account.move.list.itk.projectcategory.out.invoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='status_in_payment']" position="after">
                <field name="projectcategory_id" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_out_credit_note_tree_itk_pc" model="ir.ui.view">
        <field name="name">account.move.list.itk.projectcategory.out.refund</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_credit_note_tree"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='status_in_payment']" position="after">
                <field name="projectcategory_id" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
