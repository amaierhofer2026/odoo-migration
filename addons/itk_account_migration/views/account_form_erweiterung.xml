<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Bereich Abrechnung: feldweiser Abgleich mit Odoo 11.
        In Odoo 11 sichtbare, fachlich weiterhin relevante Felder werden in Odoo 18 sichtbar
        gemacht (die Felder existieren im Modell bereits; es wird nur die Ansicht ergaenzt).
        Odoo-18-Zusatzfelder und -funktionen bleiben unveraendert erhalten.
    -->
    <record id="view_move_form_itk_o11_kopf" model="ir.ui.view">
        <field name="name">account.move.form.itk.o11.kopf</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">97</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_info']" position="inside">
                <!-- Felder wandern in den sichtbaren Kopfbereich (account_move_form_kopf.xml) -->
            </xpath>
        </field>
    </record>

    <!-- Rechnungszeilen: Spalten wie in Odoo 11 sichtbar (Rabatt, Konto; Kostenstelle/Betrag sind vorhanden) -->
    <record id="view_move_line_tree_itk_o11" model="ir.ui.view">
        <field name="name">account.move.line.list.itk.o11.spalten</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="priority">97</field>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='account_id']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>
</odoo>
