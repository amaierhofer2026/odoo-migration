<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Bereich Abrechnung - Rechnungszeilen (Rechnung, Kunden-Gutschrift, Eingangsrechnung,
        Lieferanten-Gutschrift): sichtbare Spalten im Odoo-11-Wortlaut und in Odoo-11-Reihenfolge.

        Sichtbar:  Line NO. | Produkt / Beschreibung | Sektion | Kostenstelle | Menge |
                   Preis pro ME | Rabatt (%) | Steuern | Zwischensumme | Total
        Optional (Odoo-18-Zusatz, bleibt erhalten): Masseinheit u. a.
        Nur string-/optional-Attribute und das Produkt-Widget; technische Feldnamen unveraendert.
    -->
    <record id="view_move_line_columns_itk_o11" model="ir.ui.view">
        <field name="name">account.move.form.itk.o11.zeilenspalten</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">95</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='sequence']" position="attributes">
                <attribute name="string">Pos</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='product_id']" position="attributes">
                <attribute name="widget">many2one</attribute>
                <attribute name="string">Produkt</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='product_id']" position="after">
                <field name="display_type" string="Sektion" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='number']" position="attributes">
                <attribute name="string">Pos</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
            <!-- Session 125: genau EINE Spalte "Beschreibung" in Odoo-11-Position (nach Sektion,
                 vor Kostenstelle).
                 Ursache des Fehlers: Odoo 18 gibt der Zeilenliste das Widget
                 product_label_section_and_note_field_o2m. Dessen Renderer loescht die Spalte name
                 bewusst aus der gerenderten Tabelle und zeichnet den Text in die Produktzelle.
                 Sichtbar war dadurch gar keine Beschreibung; der zusaetzlich eingefuegte zweite
                 name-Knoten erschien nur im Spaltenauswahl-Menue (dort zweimal "Beschreibung").
                 Loesung: Odoo-18-Standardwidget section_and_note_one2many (Abschnitte, Notizen,
                 Katalog, Griffspalte, alle Spalten bleiben) - damit ist name wieder eine eigene,
                 editierbare Spalte. Technische Feldnamen und Datenlogik unveraendert. -->
            <xpath expr="//field[@name='invoice_line_ids']" position="attributes">
                <attribute name="widget">section_and_note_one2many</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='name']" position="attributes">
                <attribute name="string">Beschreibung</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='display_type']" position="attributes">
                <attribute name="string">Sektion</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='analytic_distribution']" position="attributes">
                <attribute name="string">Kostenstelle</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='quantity']" position="attributes">
                <attribute name="string">Menge</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='price_unit']" position="attributes">
                <attribute name="string">Preis pro ME</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='discount']" position="attributes">
                <attribute name="string">Rabatt (%)</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='tax_ids']" position="attributes">
                <attribute name="string">Steuern</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='price_subtotal']" position="attributes">
                <attribute name="string">Zwischensumme</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='price_total']" position="attributes">
                <attribute name="string">Total</attribute>
                <attribute name="optional">show</attribute>
                <attribute name="column_invisible">False</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='product_uom_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>
</odoo>
