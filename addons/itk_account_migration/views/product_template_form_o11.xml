<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================================
         Produktformular: Reiter- und Feldaufbau nach Odoo 11 (Bereich Abrechnung
         Verkauf/Einkauf > Verkaufbare/Einkaufbare Produkte), Session 126.

         Odoo 11 fuehrt das Formular mit den Reitern
             Allgemeine Informationen | Varianten (unsichtbar) | Verkauf | Einkauf |
             Lager | Abrechnung | Notizen | Bilder
         Odoo 18 zeigte (gemessen 05.10.2026):
             Allgemeine Informationen | Attribute & Varianten | Verkauf | Einkauf | Lager
         Der Reiter Abrechnung fehlte sichtbar, weil die Seite des account-Moduls
         (name=invoicing, Beschriftung "Buchhaltung") ueber die verborgene technische Gruppe
         account.group_account_readonly eingeschraenkt ist (0 Benutzer in der Instanz).
         Der Reiter Notizen existierte nur als Gruppe im ersten Reiter.

         Diese Ansicht stellt den Odoo-11-Aufbau her, ohne Odoo-18-Funktionen zu entfernen:
         * Reiter "Abrechnung": Beschriftung nach Odoo 11, sichtbar fuer alle Benutzer,
           Felder in den Odoo-11-Gruppen Forderungen / Verbindlichkeiten / Abrechnung /
           Eingangsrechnung. Die Odoo-18-Buchhaltungsfelder (Erloes-/Aufwandskonto,
           Preisdifferenzkonto) behalten ihre eigenen Gruppenrechte.
         * Reiter "Notizen": Beschreibungen und Warnhinweise in den Odoo-11-Gruppen.
         * Feldpositionen im ersten Reiter: Kategorie, Interne Referenz und Strichcode
           wieder in der ersten Gruppe (Odoo 11).

         Hinweis: In Odoo-18-Ansichtsvererbungen darf das Attribut "string" nicht als
         Selektor verwendet werden ("View inheritance may not use attribute 'string' as a
         selector"); Container werden deshalb ueber name oder Kindfelder ausgewaehlt.

         Nicht nachbaubar (Feld im Odoo-18-Modell nicht vorhanden, kein Dummy-Feld):
           service_policy, project_id (Odoo 11 Abrechnung), property_valuation,
           property_stock_account_input/-output (Odoo 11 Bestandsbewertung),
           product_image_ids (Odoo 11 Reiter Bilder; in Odoo 11 zusaetzlich 0 von 649
           Produkten belegt, product.image in Odoo 18 entfernt).
         Dokumentation: docs/o11-o18-vergleich-abrechnung-produktformular.md
    -->
    <record id="view_product_template_form_o11_reiter" model="ir.ui.view">
        <field name="name">product.template.form.itk.o11.reiter</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">

            <!-- ============ 1. Reiter "Abrechnung" (Odoo 11: page invoicing) ============ -->
            <xpath expr="//page[@name='invoicing']" position="attributes">
                <!-- Odoo 11: "Abrechnung"; Odoo 18 (account-Modul): "Buchhaltung" -->
                <attribute name="string">Abrechnung</attribute>
                <!-- Odoo 11 zeigte den Reiter allen Benutzern (keine Gruppenbeschraenkung).
                     Ohne diese Zeile bleibt die ganze Seite fuer nicht buchhaltende
                     Benutzer unsichtbar (account.group_account_readonly, 0 Benutzer). -->
                <attribute name="groups"/>
            </xpath>
            <xpath expr="//page[@name='invoicing']//group[@name='properties']" position="attributes">
                <!-- Container oeffnen (Odoo 11 hatte hier keine Rechtepruefung);
                     die einzelnen Buchhaltungsfelder behalten ihre Gruppenrechte. -->
                <attribute name="groups"/>
            </xpath>

            <!-- Forderungen: Steuern (Verkauf) vor dem Erloeskonto (Odoo-11-Reihenfolge) -->
            <xpath expr="//page[@name='invoicing']//field[@name='property_account_income_id']" position="before">
                <xpath expr="//label[@for='taxes_id']" position="move"/>
                <xpath expr="//div[@name='taxes_div']" position="move"/>
            </xpath>

            <!-- Verbindlichkeiten: Steuern (Einkauf) vor dem Aufwandskonto -->
            <xpath expr="//page[@name='invoicing']//field[@name='property_account_expense_id']" position="before">
                <xpath expr="//field[@name='supplier_taxes_id']" position="move"/>
            </xpath>

            <!-- Odoo-11-Gruppen "Abrechnung" (Fakturierungsregel) und "Eingangsrechnung"
                 (Kontrollrichtlinie) hinter der Buchhaltungsgruppe.
                 Hinweis: position="move" wirkt nur als direktes Kind der XPath-Angabe,
                 deshalb werden die Gruppen zuerst angelegt und die Felder danach
                 einzeln hineinverschoben. -->
            <xpath expr="//page[@name='invoicing']//group[@name='accounting']" position="after">
                <group name="itk_invoicing_block">
                    <group name="itk_invoicing" string="Abrechnung"/>
                    <group name="itk_bill" string="Eingangsrechnung"/>
                </group>
            </xpath>
            <xpath expr="//page[@name='invoicing']//group[@name='itk_invoicing']" position="inside">
                <xpath expr="//field[@name='invoice_policy']" position="move"/>
            </xpath>
            <xpath expr="//page[@name='invoicing']//group[@name='itk_bill']" position="inside">
                <xpath expr="//field[@name='purchase_method']" position="move"/>
            </xpath>

            <!-- ============ 2. Reiter "Notizen" (Odoo 11: page notes) ============ -->
            <xpath expr="//page[@name='invoicing']" position="after">
                <page string="Notizen" name="notes">
                    <group string="Description for Internal">
                        <!-- Odoo-11-Wortlaut; die Odoo-18-Gruppe "Notizen" im ersten Reiter
                             entfaellt (Feld steht jetzt im Reiter Notizen wie in Odoo 11).
                             Odoo 11 zeigte die Felder mit Beschriftung (Odoo 18 hatte hier
                             nolabel="1"), Platzhalter der Odoo-18-Ansicht bleiben erhalten. -->
                        <field name="description" colspan="2"
                               placeholder="Dieser Hinweis dient nur internen Zwecken."/>
                    </group>
                    <group name="description">
                        <group string="Beschreibung für Kunden">
                            <field name="description_sale" colspan="2"
                                   placeholder="Die Notiz wird Verkaufsaufträgen und Rechnungen hinzugefügt."/>
                        </group>
                        <group string="Beschreibung für Lieferanten">
                            <field name="description_purchase"
                                   placeholder="Diese Notiz wird zu den Bestellungen hinzugefügt."/>
                        </group>
                    </group>
                    <group>
                        <group string="Beschreibung für Auslieferungsaufträge">
                            <field name="description_pickingout"
                                   placeholder="Dieser Hinweis wird bei Lieferaufträgen hinzugefügt."/>
                        </group>
                        <group string="Beschreibung für Wareneingang">
                            <field name="description_pickingin"
                                   placeholder="Diese Notiz wird den Eingangsaufträgen hinzugefügt (z. B. wo das Produkt im Lagerhaus gelagert werden soll)."/>
                        </group>
                        <group string="Beschreibung für interne Transfers">
                            <!-- In Odoo 11 sichtbar, in Odoo 18 aus dem Formular entfernt
                                 (Feld im Modell vorhanden) -->
                            <field name="description_picking"/>
                        </group>
                    </group>
                    <group name="warning"/>
                </page>
            </xpath>
            <!-- Die Odoo-18-Warngruppen tragen bereits die Odoo-11-Titel und werden mit
                 ihren Feldern verschoben (Platzhalter und Bedingungen bleiben erhalten) -->
            <xpath expr="//page[@name='notes']//group[@name='warning']" position="inside">
                <xpath expr="//page[@name='sales']//group[field[@name='sale_line_warn']]" position="move"/>
                <xpath expr="//page[@name='purchase']//group[field[@name='purchase_line_warn']]"
                       position="move"/>
            </xpath>

            <!-- ============ 3. Aufraeumen: leere Huellen der Herkunftsreiter ============ -->
            <!-- Die Felder der Beschreibungen wurden oben neu eingefuegt; hier entfallen die
                 Odoo-18-Huellen, damit keine leeren Gruppen und keine Felddoppelungen bleiben -->
            <xpath expr="//page[@name='general_information']//group[@name='internal_notes']" position="replace"/>
            <xpath expr="//page[@name='sales']//group[@name='description']" position="replace"/>
            <xpath expr="//page[@name='purchase']//group[field[@name='description_purchase']]" position="replace"/>
            <xpath expr="//page[@name='inventory']//group[field[@name='description_pickingin']]" position="replace"/>
            <xpath expr="//page[@name='inventory']//group[field[@name='description_pickingout']]" position="replace"/>
            <xpath expr="//page[@name='inventory']/group[last()]" position="replace"/>
            <!-- Die Einkaufs-Warngruppe ist in den Reiter Notizen gewandert; die leere
                 Huellengruppe entfaellt -->
            <xpath expr="//page[@name='purchase']//group[@col='1']" position="replace"/>

            <!-- ============ 4. Erster Reiter: Kategorie, Referenz, Strichcode in die
                 erste Gruppe (Odoo 11: direkt hinter dem Produkttyp) ============ -->
            <!-- Hinweis: Felder als direkte Kinder einer Gruppe verlieren in Odoo 18 ihre
                 Beschriftung (kein Label-Knoten im DOM). Sie kommen deshalb in eine eigene
                 Gruppe ohne string - dann tragen sie ihre Beschriftung. -->
            <xpath expr="//group[@name='product_type']" position="after">
                <group name="itk_kategorie_referenz"/>
            </xpath>
            <xpath expr="//group[@name='itk_kategorie_referenz']" position="inside">
                <xpath expr="//page[@name='general_information']//field[@name='categ_id']" position="move"/>
                <xpath expr="//page[@name='general_information']//field[@name='default_code']" position="move"/>
                <xpath expr="//page[@name='general_information']//field[@name='barcode']" position="move"/>
            </xpath>

            <!-- ============ 5. Sichtbare Beschriftungen nach Odoo 11 ============ -->
            <xpath expr="//field[@name='categ_id']" position="attributes">
                <attribute name="string">Interne Kategorie</attribute>
            </xpath>
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="string">Interne Referenz</attribute>
            </xpath>
            <xpath expr="//field[@name='sale_line_warn']" position="attributes">
                <attribute name="string">Auftragsposition</attribute>
            </xpath>
            <xpath expr="//field[@name='sale_line_warn_msg']" position="attributes">
                <attribute name="string">Mitteilung für Auftragszeile</attribute>
            </xpath>
            <xpath expr="//field[@name='purchase_line_warn']" position="attributes">
                <!-- Odoo 11 zeigte die Felder mit Beschriftung (Odoo 18 hatte nolabel="1") -->
                <attribute name="nolabel"/>
                <attribute name="string">Bestellposition</attribute>
            </xpath>
            <xpath expr="//field[@name='purchase_line_warn_msg']" position="attributes">
                <attribute name="nolabel"/>
            </xpath>
        </field>
    </record>

</odoo>
