<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================================
         Produktliste der Menues Abrechnung > Verkauf/Einkauf > Verkaufbare/Einkaufbare
         Produkte: Spalten nach Odoo 11 (Session 126).

         Beide Menuepunkte verwenden dieselben Ansichten (Aktionen 382 und 383,
         res_model product.template, Listenansicht account.product_template_view_tree);
         sie unterscheiden sich nur im Standardfilter (search_default_filter_to_sell bzw.
         search_default_filter_to_purchase).

         Odoo 11 zeigte in der Liste (product.product tree):
             Interne Referenz | Name | Attributwerte | Verkaufspreis | Verfuegbar |
             Prognostiziert | Mengeneinheit | Strichcode
         Odoo 18 zeigte:
             Interne Referenz | Name | Verkaufspreis | Steuern (Verkauf) | Steuern (Einkauf)
         Die vier fehlenden Odoo-11-Spalten werden ergaenzt, die Odoo-18-Zusatzspalten
         (Steuern, Aktivitaets-Symbol) bleiben an ihrem Platz am Ende.
         Die Attributwert-Spalte der Odoo-11-Liste entfaellt: Odoo 18 fuehrt die Menues auf
         product.template (eine Zeile je Vorlage), Attribute stehen im Reiter
         "Attribute & Varianten"; im Odoo-11-Bestand gibt es keine Produkte mit Attributen.
         Dokumentation: docs/o11-o18-vergleich-abrechnung-produktformular.md
    -->
    <record id="view_product_template_list_o11_spalten" model="ir.ui.view">
        <field name="name">product.template.list.itk.o11.spalten</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_view_tree"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="after">
                <field name="qty_available" optional="show"/>
                <field name="virtual_available" optional="show"/>
                <field name="uom_id" optional="show"/>
                <field name="barcode" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
