<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================================
         Listenansicht der Menuepunkte Abrechnung > Verkauf/Einkauf > Verkaufbare bzw.
         Einkaufbare Produkte (Session 128 Einkauf, Session 129 Verkauf).

         Odoo-11-Sollzustand (read-only gemessen, ITK_V1_a):
             Menue Abrechnung/Einkauf/Stammdaten/Einkaufbare Produkte (id 169)
             -> Aktion 226 "Einkaufbare Produkte", res_model product.product,
                view_id 571 = account.product_product_view_tree (primaere Liste),
                context {'search_default_filter_to_purchase': 1}
             Menue Abrechnung/Verkauf/Stammdaten/Verkaufbare Produkte
             -> Aktion 225 "Verkaufbare Produkte", res_model product.product,
                view_id 571 (DIESELBE Ansicht), context {'search_default_filter_to_sell': 1}
             Spalten der Ansicht 571 (Dokumentreihenfolge):
                 default_code (Interne Referenz) | name (Name) |
                 attribute_value_ids (unsichtbar, groups product.group_product_variant) |
                 lst_price (Verkaufspreis) | taxes_id (Steuern (Verkauf)) |
                 supplier_taxes_id (Steuern (Einkauf))

         Odoo 18 vorher:
             Beide Aktionen (382 account.product_product_action_sellable,
             383 account.product_product_action_purchasable) hatten KEINE eigene Liste;
             angezeigt wurde die Standardliste product.template.product.list (id 860) mit
             den Erweiterungen stock/stock_account/itk_product - rund zwanzig Feldzeilen,
             andere Reihenfolge, ohne Steuerspalten, und auf der VM englische
             Beschriftungen (Sales Taxes, Purchase Taxes, Quantity On Hand, Forecasted
             Quantity, Unit of Measure, Barcode, Sales, Purchase, # Product Variants).
             Die frueher angelegte Vererbung view_product_template_list_o11_spalten
             (Ergaenzung von qty_available/virtual_available/uom_id/barcode in der Ansicht
             1023 account.product_template_view_tree) war wirkungslos, weil keine der
             Aktionen diese Ansicht benutzt.

         Odoo 18 nachher: eigene primaere Liste mit den Odoo-11-Spalten in Odoo-11-
         Reihenfolge und deutschem Odoo-11-Wortlaut; die Odoo-18-Zusatzspalten bleiben
         vorhanden, sind aber standardmaessig ausgeblendet (Spaltenauswahl).
         An beide Aktionen gebunden ueber ir.actions.act_window.view (kein Eingriff in die
         Aktionen selbst, dadurch bleiben die uebrigen Produktlisten unveraendert).
         Dokumentation: docs/o11-o18-abrechnung-einkaufbare-produktliste.md
    -->
    <record id="view_product_template_list_o11_spalten" model="ir.ui.view">
        <field name="name">product.template.list.itk.o11.produkte</field>
        <field name="model">product.template</field>
        <field name="inherit_id" eval="False"/>
        <field name="mode">primary</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Produkte">
                <!-- Technische Hilfsspalten (nicht sichtbar), wie in der Odoo-18-Standardliste:
                     Waehrung fuer die Geldspalten, sale_ok fuer die Abschwaechung, active fuer
                     die Archiv-Anzeige. -->
                <field name="currency_id" column_invisible="True"/>
                <field name="cost_currency_id" column_invisible="True"/>
                <field name="active" column_invisible="True"/>
                <field name="show_on_hand_qty_status_button" column_invisible="True" groups="stock.group_stock_user"/>

                <!-- Odoo-11-Spalten in Odoo-11-Reihenfolge mit Odoo-11-Wortlaut -->
                <field name="default_code" string="Interne Referenz"/>
                <field name="name" string="Name"/>
                <field name="list_price" string="Verkaufspreis" widget="monetary"
                       options="{'currency_field': 'currency_id'}" decoration-muted="not sale_ok"/>
                <field name="taxes_id" string="Steuern (Verkauf)" widget="many2many_tags"
                       context="{'append_fields': ['company_id']}"/>
                <field name="supplier_taxes_id" string="Steuern (Einkauf)" widget="many2many_tags"
                       context="{'append_fields': ['company_id']}"/>

                <!-- Odoo-18-Zusatzspalten: vorhanden, standardmaessig ausgeblendet,
                     ueber die Spaltenauswahl zuschaltbar. Beschriftung im Odoo-11-Wortlaut,
                     wenn Odoo 11 das Feld kannte. -->
                <field name="product_variant_count" string="# Produkt Varianten" optional="hide"/>
                <field name="categ_id" string="Interne Kategorie" optional="hide"/>
                <field name="product_type_id" string="Status" optional="hide"/>
                <field name="type" string="Produktart" readonly="1" optional="hide"/>
                <field name="standard_price" string="Kosten" widget="monetary"
                       options="{'currency_field': 'cost_currency_id'}" readonly="1" optional="hide"/>
                <field name="uom_id" string="Mengeneinheit" readonly="1" groups="uom.group_uom" optional="hide"/>
                <field name="uom_po_id" string="Einkauf ME" readonly="1" groups="uom.group_uom" optional="hide"/>
                <field name="barcode" string="Strichcode" readonly="product_variant_count != 1" optional="hide"/>
                <field name="qty_available" string="Bestandsmenge"
                       invisible="not show_on_hand_qty_status_button" decoration-danger="qty_available &lt; 0"
                       groups="stock.group_stock_user" optional="hide"/>
                <field name="virtual_available" string="Prognostizierter Bestand"
                       invisible="not show_on_hand_qty_status_button" decoration-danger="virtual_available &lt; 0"
                       decoration-bf="1" groups="stock.group_stock_user" optional="hide"/>
                <field name="responsible_id" string="Verantwortlich" widget="many2one_avatar_user"
                       groups="stock.group_stock_user" optional="hide"/>
                <field name="product_tag_ids" string="Stichwörter" widget="many2many_tags" optional="hide"/>
                <field name="is_favorite" string="Favorit" widget="boolean_favorite" nolabel="1" optional="hide"/>
                <field name="sale_ok" string="Kann verkauft werden" widget="boolean_toggle" optional="hide"/>
                <field name="purchase_ok" string="Kann eingekauft werden" widget="boolean_toggle" optional="hide"/>

                <!-- Aktivitaets-Symbol der Odoo-18-Standardliste (Zusatzfunktion) -->
                <field name="activity_exception_decoration" widget="activity_exception"/>
            </list>
        </field>
    </record>

    <!-- Die Liste an die beiden Menuepunkte binden (Odoo-11-Vorbild: view_id 571 der
         Aktionen 225 und 226). Beide Punkte unterscheiden sich nur im Standardfilter;
         in Odoo 11 zeigten sie dieselbe Ansicht 571. -->
    <record id="action_product_product_action_purchasable_view_list" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="account.product_product_action_purchasable"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_product_template_list_o11_spalten"/>
        <field name="sequence">1</field>
    </record>

    <record id="action_product_product_action_sellable_view_list" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="account.product_product_action_sellable"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_product_template_list_o11_spalten"/>
        <field name="sequence">1</field>
    </record>

</odoo>
