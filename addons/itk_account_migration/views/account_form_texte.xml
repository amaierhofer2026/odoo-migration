<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bereich Abrechnung: verbleibende sichtbare Bezeichnungen im Odoo-11-Wortlaut.
         Nur string-Attribute; technische Namen bleiben unveraendert. -->
    <record id="view_move_form_itk_o11_reiter" model="ir.ui.view">
        <field name="name">account.move.form.itk.o11.reiter</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">98</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='invoice_tab']" position="attributes">
                <attribute name="string">Rechnung</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_analytic_projektzahl_itk_o11" model="ir.ui.view">
        <field name="name">account.analytic.account.form.itk.o11.projektanzahl</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="project.account_analytic_account_view_form_inherit"/>
        <field name="priority">98</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='project_count']" position="attributes">
                <attribute name="string">Projekt-Anzahl</attribute>
            </xpath>
        </field>
    </record>
</odoo>
