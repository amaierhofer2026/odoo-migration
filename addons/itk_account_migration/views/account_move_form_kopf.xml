<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Bereich Abrechnung - Rechnungsformular (Menue Verkauf > Ausgangsrechnungen):
        sichtbarer Aufbau wie in Odoo 11. Die Odoo-11-Kopffelder stehen im sichtbaren Kopfbereich.
        Reihenfolge der xpaths ist wichtig: zuerst die Originalfelder ausblenden, danach die
        sichtbaren Kopien in den Kopfbereich setzen (sonst erscheinen sie doppelt).
        Technische Feldnamen und Modelle bleiben unveraendert.
    -->
    <record id="view_move_form_kopf_itk_o11" model="ir.ui.view">
        <field name="name">account.move.form.itk.o11.kopfbereich</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">95</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_payment_term_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='sale_order_benefit_period']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='projectcategory_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_user_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='team_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <group name="itk_o11_kopf" string="Angaben wie in Odoo 11">
                    <field name="invoice_payment_term_id" invisible="move_type == 'entry'"/>
                    <field name="sale_order_benefit_period" invisible="move_type == 'entry'"/>
                    <field name="projectcategory_id" invisible="move_type == 'entry'"/>
                    <field name="invoice_user_id" invisible="move_type == 'entry'"/>
                    <field name="team_id" invisible="move_type == 'entry'"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Rechnungszeilen: Odoo-11-Spalten sichtbar, benannt und in Odoo-11-Reihenfolge -->
    <record id="view_move_line_columns_itk_o11" model="ir.ui.view">
        <field name="name">account.move.form.itk.o11.zeilenspalten</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">95</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='sequence']" position="attributes">
                <attribute name="string">Pos</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='product_id']" position="attributes">
                <attribute name="widget">many2one</attribute>
                <attribute name="string">Produkt</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='name']" position="attributes">
                <attribute name="widget">text</attribute>
                <attribute name="string">Beschreibung</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='analytic_distribution']" position="attributes">
                <attribute name="string">Kostenstelle</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='quantity']" position="attributes">
                <attribute name="string">Menge</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='price_unit']" position="attributes">
                <attribute name="string">Preis pro ME</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='discount']" position="attributes">
                <attribute name="string">Rabatt (%)</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='tax_ids']" position="attributes">
                <attribute name="string">Steuern</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='price_subtotal']" position="attributes">
                <attribute name="string">Zwischensumme</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='product_uom_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>
</odoo>
