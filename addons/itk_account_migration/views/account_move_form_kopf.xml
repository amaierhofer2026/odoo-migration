<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Bereich Abrechnung - Rechnung/Gutschrift: Kopfbereich kompakt nach Odoo 11.

        Aufbau (eine flache Gruppe mit col="4" = zwei Feldpaare je Zeile, dadurch bleibt
        der Kopf kompakt und niedrig, keine Leerflaechen):

            Zeile 1: Kunde                  | Rechnungsdatum
            Zeile 2: Lieferadresse          | Faelligkeit
            Zeile 3: Zahlungsbedingungen    | Verkaeufer
            Zeile 4: Leistungszeitraum      | Vertriebskanal
            Zeile 5: Project Category       | Waehrung (Odoo-18-Zusatz, bleibt erhalten)

        Die Gruppe steht direkt oben im Formular (vor dem Odoo-18-Kopfblock). Die Vorkommen
        der verschobenen Felder im Odoo-18-Block werden samt Beschriftung ausgeblendet, damit
        nichts doppelt erscheint. Keine verschachtelte Gruppe, kein kuenstliches colspan.
        Technische Feldnamen, Modelle und Odoo-18-Zusatzfunktionen bleiben unveraendert.
    -->
    <record id="view_move_form_kopf_itk_o11" model="ir.ui.view">
        <field name="name">account.move.form.itk.o11.kopfbereich</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <!-- Beschriftungen der verschobenen Felder im Odoo-18-Block entfernen -->
            <xpath expr="//label[@for='partner_id']" position="replace"/>
            <xpath expr="//label[@for='invoice_date']" position="replace"/>
            <xpath expr="//label[@for='invoice_date_due']" position="replace"/>
            <xpath expr="//label[@for='invoice_payment_term_id']" position="replace"/>
            <xpath expr="//label[@for='currency_id']" position="replace"/>

            <!-- Vorkommen der verschobenen Felder im Odoo-18-Block ausblenden -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_shipping_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_date_due']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_payment_term_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='sale_order_benefit_period']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='projectcategory_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_user_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='team_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='valorisierung_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='currency_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Waehrungsanzeige im Odoo-18-Block (schwebender Wert) ausblenden -->
            <xpath expr="//div[field[@name='currency_id']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>


            <!-- Reste des Odoo-18-Kopfblocks: aktive Widgets ohne Beschriftung aus der View nehmen.
                 Die Felder selbst bleiben im Modell erhalten (keine Modellaenderung). -->
            <xpath expr="//div[@name='due_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='journal_div']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='sale_order_confirmation_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='notice']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Kompakter Odoo-11-Kopfblock, direkt oben; zwei Feldpaare je Zeile -->
            <xpath expr="//field[@name='partner_id']/ancestor::group[2]" position="before">
                <group name="itk_o11_kopfbereich">
                    <group>
                        <label for="partner_id" string="Kunde" invisible="move_type in ('in_invoice', 'in_refund')"/>
                        <label for="partner_id" string="Lieferant" invisible="move_type not in ('in_invoice', 'in_refund')"/>
                        <!-- Session 126: KEIN required="1". Odoo 18 fuehrt account.move.partner_id nicht als
                             pflichtiges Feld (Odoo 11 hatte es modellpflichtig). Mit required="1" in der
                             Ansicht liessen sich vorhandene Entwuerfe ohne Partner nicht mehr speichern und
                             der Client meldete "Ungueltige Felder: Partner"; die sichtbare Beschriftung war
                             dadurch ausserdem fett (Odoo 18 stellt nur pflichtige Felder fett dar).
                             Odoo-18-Pruefungen beim Buchen bleiben unveraendert. -->
                        <field name="partner_id" nolabel="1" readonly="state != 'draft'"/>
                        <field name="partner_shipping_id" readonly="state != 'draft'"/>
                        <field name="invoice_payment_term_id" invisible="move_type == 'entry'"/>
                        <field name="sale_order_benefit_period" invisible="move_type == 'entry'"/>
                        <field name="projectcategory_id" invisible="move_type == 'entry'"/>
                    </group>
                    <group>
                        <field name="invoice_date" invisible="move_type == 'entry'"/>
                        <field name="invoice_date_due" invisible="move_type in ('entry', 'in_invoice', 'in_refund')"/>
                        <field name="invoice_user_id" invisible="move_type == 'entry'"/>
                        <field name="team_id" invisible="move_type == 'entry'"/>
                        <field name="currency_id" groups="base.group_multi_currency" invisible="move_type == 'entry'"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Reiter "Rechnung" heisst in Odoo 11 "Rechnungszeilen" -->
    <record id="view_move_form_tab_itk_o11" model="ir.ui.view">
        <field name="name">account.move.form.itk.o11.reiter</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='invoice_tab']" position="attributes">
                <attribute name="string">Rechnungszeilen</attribute>
            </xpath>
        </field>
    </record>
</odoo>
