<?xml version="1.0" encoding="utf-8" ?>
<!--
    ITK Massenbearbeitung (Session 140)

    Odoo 11 hatte unter Einstellungen > Massenverarbeitung eine eigene Liste der
    Massenaktions-Objekte (mass.object). Odoo 18 kennt kein mass.object; die
    Massenbearbeitung sind Server-Aktionen mit state = mass_edit.

    Dieses Modul stellt den Menuepunkt an derselben Stelle wieder her und zeigt
    ausschliesslich die tatsaechlichen Massenbearbeitungs-Aktionen
    (Domain state = mass_edit). Es wird keine neue Logik eingefuehrt.
-->
<odoo>
    <record id="view_itk_mass_edit_server_action_list" model="ir.ui.view">
        <field name="name">itk.mass.edit.server.action.list</field>
        <field name="model">ir.actions.server</field>
        <field name="arch" type="xml">
            <list string="Massenverarbeitung" create="1">
                <field name="name" />
                <field name="model_id" />
                <field name="binding_model_id" optional="show" />
                <field name="state" column_invisible="True" />
            </list>
        </field>
    </record>

    <record id="action_itk_massenbearbeitung" model="ir.actions.act_window">
        <field name="name">Massenverarbeitung</field>
        <field name="res_model">ir.actions.server</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_itk_mass_edit_server_action_list')})]" />
        <field name="domain">[('state', '=', 'mass_edit')]</field>
        <field name="context">{'default_state': 'mass_edit'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Massenverarbeitung anlegen</p>
            <p>
                Hier stehen die Massenbearbeitungs-Aktionen, die im Menue "Aktion" der
                jeweiligen Liste erscheinen. Eine Aktion besteht aus Name, Modell und
                einem oder mehreren Feldern. Im Dialog kann der Benutzer je Feld
                "Nicht ändern", "Setzen" oder "Entfernen" waehlen.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_massenbearbeitung"
        name="Massenverarbeitung"
        parent="base.menu_administration"
        action="action_itk_massenbearbeitung"
        sequence="60"
    />
</odoo>
