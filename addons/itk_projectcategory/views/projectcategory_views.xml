<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Menueplatzierung (Session 131, 07.10.2026):
        Das Modul legte bisher eine EIGENE Navigationssektion "Konfiguration" unter der App
        Abrechnung an (menuitem menu_finance_configuration parent=account.menu_finance).
        Odoo 11 hatte diesen Menuepunkt nicht: dort gab es kein Menue und keine Fensteraktion
        fuer itk_projectcategory.projectcategory (read-only geprueft), nur das Feld am Beleg.
        In Odoo 18 erschien dadurch eine dritte Sektion "Konfiguration" in der Navigationsleiste
        (Odoo-11-Stand: zwei - account und itk_valorisierung).
        Der Menuepunkt liegt jetzt wie "Produktkategorien" unter Abrechnung > Konfiguration >
        Verwaltung. Funktion und Daten bleiben unveraendert; die eigene Sektion entfaellt.
        Wortlaut (Session 131, 08.10.2026, Entscheidung Anna): Menue und Aktion heissen deutsch
        "Projektkategorien" (Plural wie im Menue "Produktkategorien"). Beleg: Odoo 11 fuehrt
        KEIN Menue fuer dieses Modell (read-only geprueft, 0 Treffer); der Odoo-11-Wortlaut fuer
        die Sache ist "Projektkategorie" (Aktion "Massenverarbeitung Projektkategorie setzen").
        Nachtrag 08.10.2026: Das frueher hier stehende <delete id="menu_finance_configuration"/>
        ist entfernt. Die technische Kennung existiert nach der einmaligen Bereinigung nicht mehr
        (weder lokal noch auf der VM; ir.model.data geprueft), und ein <delete> auf eine fehlende
        Kennung laesst das Upgrade mit "External ID not found in the system" scheitern.
    -->
    <!--START Action and Menuentry-->
    <record model="ir.actions.act_window" id="menu_finance_configuration_projectcategory_action">
        <field name="name">Project Categories</field>
        <field name="res_model">itk_projectcategory.projectcategory</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">Create the first Project Category
            </p>
        </field>
    </record>

    <menuitem id="menu_finance_configuration_projectcategory" name="Project Categories"
              parent="account.account_management_menu" sequence="5"
              action="menu_finance_configuration_projectcategory_action"/>
    <!--END Action and Menuentry-->



       <!--START Treeview and Formview -->
        <record model="ir.ui.view" id="tree_view_projektcategory">
            <field name="name">itk_projectcategory.projectcategory.tree</field>
            <field name="model">itk_projectcategory.projectcategory</field>
            <field name="arch" type="xml">
                <!-- Odoo 11 hat fuer dieses Modell keine Listenansicht; die Beschriftung war
                     ein Altbestand aus dem Quellprojekt ("Fields of Law") und wird auf die
                     Beschriftung des Modells gesetzt (Odoo 11 und Odoo 18: "Project Category"). -->
                <list string="Project Category">
                    <field name="name"/>
                    <field name="code"/>
                    <field name ="seq"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="form_view_projektcategory">
            <field name="name">itk_projectcategory.projectcategory.form</field>
            <field name="model">itk_projectcategory.projectcategory</field>
            <field name="arch" type="xml">
                <form string="Project Category">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name ="seq"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <!--END Treeview and Formview -->



</odoo>
