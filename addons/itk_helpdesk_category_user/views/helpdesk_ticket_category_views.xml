<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Add user_id to category form -->
    <record id="view_helpdesk_category_form_inherit" model="ir.ui.view">
        <field name="name">helpdesk.ticket.category.form.inherit</field>
        <field name="model">helpdesk.ticket.category</field>
        <field name="inherit_id" ref="helpdesk_mgmt.view_helpdesk_category_form"/>
        <field name="arch" type="xml">
            <field name="show_in_portal" position="after">
                <field name="user_id"/>
            </field>
        </field>
    </record>

    <!-- Add user_id to category list -->
    <record id="view_helpdesk_category_tree_inherit" model="ir.ui.view">
        <field name="name">helpdesk.ticket.category.list.inherit</field>
        <field name="model">helpdesk.ticket.category</field>
        <field name="inherit_id" ref="helpdesk_mgmt.view_helpdesk_category_tree"/>
        <field name="arch" type="xml">
            <field name="parent_id" position="after">
                <field name="user_id" optional="show"/>
            </field>
        </field>
    </record>

    <!-- Add user_id to category search view -->
    <record id="view_helpdesk_category_search_inherit" model="ir.ui.view">
        <field name="name">helpdesk.ticket.category.search.inherit</field>
        <field name="model">helpdesk.ticket.category</field>
        <field name="inherit_id"
               ref="helpdesk_mgmt.view_helpdesk_ticket_category_search"/>
        <field name="arch" type="xml">
            <field name="parent_id" position="after">
                <field name="user_id"/>
            </field>
        </field>
    </record>
</odoo>
