<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Remove "Powered by Odoo" and "Create a free website with Odoo" promotional message -->
    <template id="brand_promotion"
              inherit_id="website.brand_promotion"
              name="Remove Odoo Promotional Link"
              priority="20">
        <xpath expr="//div[hasclass('o_brand_promotion')]" position="replace">
            <div class="o_brand_promotion" style="display: none;"/>
        </xpath>
    </template>

</odoo>
