<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_itk_purchaseorder_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context({'lang':doc.partner_id.lang})"/>
            <div class="page" style="font-size: 13px;">

                <!-- Lieferantenadresse + Bestelldatum -->
                <div class="row mt-3">
                    <div class="col-7">
                        <div t-if="doc.partner_id.parent_id"><t t-esc="doc.partner_id.parent_id.name"/></div>
                        <div><t t-esc="doc.partner_id.name"/></div>
                        <div><span t-field="doc.partner_id.street"/></div>
                        <div t-if="doc.partner_id.street2"><span t-field="doc.partner_id.street2"/></div>
                        <div>
                            <span t-field="doc.partner_id.zip"/>
                            <span t-field="doc.partner_id.city"/>
                        </div>
                        <div t-if="doc.partner_id.country_id"><span t-field="doc.partner_id.country_id.name"/></div>
                    </div>
                    <div class="col-5 text-end">
                        <strong>Bestelldatum </strong>
                        <span t-field="doc.date_order" t-options='{"format": "dd.MM.yyyy"}'/>
                    </div>
                </div>

                <h4 class="mt-4">Bestellung <span t-field="doc.name"/></h4>

                <div class="mt-3">Hiermit bestellen wir nachfolgend aufgeführte Artikel zu den genannten Konditionen und den genannten Lieferzeitpunkten.</div>

                <table class="table table-sm mt-3">
                    <thead>
                        <tr>
                            <th class="text-center" style="background-color:#bbbbbb;">Pos</th>
                            <th class="text-start" style="background-color:#bbbbbb;">Leistungsgegenstand</th>
                            <th class="text-center" style="background-color:#bbbbbb;">Lieferdatum</th>
                            <th class="text-end" style="background-color:#bbbbbb;">Menge</th>
                            <th class="text-end" style="background-color:#bbbbbb;">Einzelpreis</th>
                            <th class="text-start" style="background-color:#bbbbbb;">Steuern</th>
                            <th class="text-end" style="background-color:#bbbbbb;">Gesamtpreis</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.order_line" t-as="line">
                            <td class="text-center"><span t-esc="line_index + 1"/></td>
                            <td><span t-field="line.name"/></td>
                            <td class="text-center"><span t-field="line.date_planned" t-options='{"format": "dd.MM.yyyy"}'/></td>
                            <td class="text-end">
                                <span t-field="line.product_qty"/>
                                <span t-field="line.product_uom.name"/>
                            </td>
                            <td class="text-end"><span t-field="line.price_unit"/></td>
                            <td><span t-esc="', '.join(line.taxes_id.mapped('name'))"/></td>
                            <td class="text-end">
                                <span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div class="clearfix">
                    <div class="row">
                        <div class="col-6 col-md-5 ms-auto">
                            <table class="table table-sm">
                                <tr>
                                    <td><strong>Nettosumme</strong></td>
                                    <td class="text-end"><span t-field="doc.amount_untaxed" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                </tr>
                                <tr>
                                    <td>Steuern</td>
                                    <td class="text-end"><span t-field="doc.amount_tax" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                </tr>
                                <tr>
                                    <td><strong>Gesamtsumme</strong></td>
                                    <td class="text-end"><span t-field="doc.amount_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="mt-3">Wir bitten um Lieferung zu den genannten Zeitpunkten.</div>
                <div t-if="doc.notes" class="mt-2"><span t-field="doc.notes"/></div>
                <div class="mt-3">Ihr Team von<br/>IT-Kommunal GmbH<br/><br/>www.it-kommunal.at</div>
                <div class="oe_structure"/>
            </div>
        </t>
    </template>

    <template id="report_itk_purchaseorder">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="itk_reports.report_itk_purchaseorder_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

</odoo>
