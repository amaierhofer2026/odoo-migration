<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_itk_purchasequotation_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context({'lang':doc.partner_id.lang})"/>
            <div class="page" style="font-size: 13px;">

                <!-- Lieferantenadresse + Anfragedatum -->
                <div class="row mt-3">
                    <div class="col-7">
                        <div t-if="doc.partner_id.parent_id"><t t-esc="doc.partner_id.parent_id.name"/></div>
                        <div><t t-esc="doc.partner_id.name"/></div>
                        <div><span t-field="doc.partner_id.street"/></div>
                        <div t-if="doc.partner_id.street2"><span t-field="doc.partner_id.street2"/></div>
                        <div>
                            <span t-field="doc.partner_id.zip"/>
                            <span t-field="doc.partner_id.city"/>
                        </div>
                        <div t-if="doc.partner_id.country_id"><span t-field="doc.partner_id.country_id.name"/></div>
                    </div>
                    <div class="col-5 text-end">
                        <strong>Anfragedatum </strong>
                        <span t-field="doc.date_order" t-options='{"format": "dd.MM.yyyy"}'/>
                    </div>
                </div>

                <h4 class="mt-4">Bestellanfrage <span t-field="doc.name"/></h4>

                <div class="mt-3">Bitte senden Sie uns ein Angebot für folgende Produkte zum gegebenen Lieferzeitpunkt.</div>

                <table class="table table-sm mt-3">
                    <thead>
                        <tr>
                            <th class="text-center" style="background-color:#bbbbbb;">Pos</th>
                            <th class="text-start" style="background-color:#bbbbbb;">Leistungsgegenstand</th>
                            <th class="text-center" style="background-color:#bbbbbb;">Geplantes Lieferdatum</th>
                            <th class="text-end" style="background-color:#bbbbbb;">Menge</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.order_line" t-as="l">
                            <td class="text-center"><span t-esc="l_index + 1"/></td>
                            <td><span t-field="l.product_id.name"/></td>
                            <td class="text-center"><span t-field="l.date_planned" t-options='{"format": "dd.MM.yyyy"}'/></td>
                            <td class="text-end">
                                <span t-field="l.product_qty"/>
                                <span t-field="l.product_uom.name"/>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div class="mt-3">Wir bitten um Ihr zeitnahes Angebot.</div>
                <div class="mt-3">Ihr Team von<br/>IT-Kommunal GmbH<br/><br/>www.it-kommunal.at</div>
                <div class="oe_structure"/>
            </div>
        </t>
    </template>

    <template id="report_itk_purchasequotation">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="itk_reports.report_itk_purchasequotation_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

</odoo>
