<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_itk_invoice_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context({'lang':o.partner_id.lang})"/>
            <div class="page" style="font-size: 13px;">

                <!-- Adresse + Datum -->
                <div class="row mt-3">
                    <div class="col-7">
                        <div><t t-esc="o.partner_id.parent_id.name"/></div>
                        <div><t t-esc="o.partner_id.community_salutation"/></div>
                        <div t-if="o.partner_id.attention_of">Zu Handen <t t-esc="o.partner_id.attention_of"/></div>
                        <div><span t-field="o.partner_id.street"/></div>
                        <div t-if="o.partner_id.street2"><span t-field="o.partner_id.street2"/></div>
                        <div>
                            <span t-field="o.partner_id.zip"/>
                            <span t-field="o.partner_id.city"/>
                        </div>
                    </div>
                    <div class="col-5 text-end">
                        <strong><span t-field="o.invoice_date" t-options='{"format": "dd.MM.yyyy"}'/></strong>
                    </div>
                </div>

                <!-- Titel: Rechnung / Storno / Gutschrift -->
                <h4 class="mt-4">
                    <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Rechnung </span>
                    <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Rechnungsentwurf </span>
                    <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Storno Rechnung </span>
                    <span t-if="o.move_type == 'out_refund'">Gutschrift </span>
                    <span t-field="o.name"/>
                </h4>

                <!-- Info-Block rechts (Zahlung / Bearbeiter / Waehrung / UID) -->
                <div class="row mt-2">
                    <div class="col-6">
                        <!-- Linke Seite: Projekt/Nutzungsvereinbarung (wenn Daten vorhanden) -->
                        <table class="table table-sm table-borderless mb-0">
                            <tr t-if="o.sale_order_confirmation_date">
                                <td class="py-0"><strong>Nutzungsvereinbarung:</strong></td>
                                <td class="py-0"><span t-field="o.sale_order_confirmation_date" t-options='{"format": "dd.MM.yyyy"}'/></td>
                            </tr>
                            <tr t-if="o.projectcategory_id">
                                <td class="py-0"><strong>Projekt:</strong></td>
                                <td class="py-0"><t t-esc="o.projectcategory_id.name"/></td>
                            </tr>
                            <tr t-if="o.sale_order_benefit_period">
                                <td class="py-0"><strong>Leistungszeitraum:</strong></td>
                                <td class="py-0"><t t-esc="o.sale_order_benefit_period"/></td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-6">
                        <table class="table table-sm table-borderless mb-0">
                            <tr>
                                <td class="py-0"><strong>Zahlung:</strong></td>
                                <td class="py-0"><t t-esc="o.invoice_payment_term_id.name"/></td>
                            </tr>
                            <tr>
                                <td class="py-0"><strong>Bearbeiter/in:</strong></td>
                                <td class="py-0"><t t-esc="o.user_id.name"/></td>
                            </tr>
                            <tr>
                                <td class="py-0"><strong>Währung:</strong></td>
                                <td class="py-0"><t t-esc="o.currency_id.name"/></td>
                            </tr>
                            <tr>
                                <td class="py-0"><strong>Ihre UID-Nr.:</strong></td>
                                <td class="py-0"><t t-esc="o.partner_id.vat"/></td>
                            </tr>
                        </table>
                    </div>
                </div>

                <!-- Positionstabelle -->
                <t t-set="display_discount" t-value="any([l.discount for l in o.invoice_line_ids])"/>
                <table class="table table-sm mt-3">
                    <thead>
                        <tr>
                            <th class="text-start" style="background-color:#bbbbbb;">Pos</th>
                            <th class="text-start" style="background-color:#bbbbbb;">Leistungsgegenstand</th>
                            <th class="text-end" style="background-color:#bbbbbb;">Menge</th>
                            <th class="text-end" style="background-color:#bbbbbb;">Einzelpreis</th>
                            <th class="text-end" style="background-color:#bbbbbb;">Gesamtpreis</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.invoice_line_ids" t-as="l">
                            <td><span t-field="l.number"/></td>
                            <td><span t-field="l.name"/></td>
                            <td class="text-end"><span t-field="l.quantity"/></td>
                            <td class="text-end">
                                <span t-field="l.price_unit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                            <td class="text-end">
                                <span t-field="l.price_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <!-- Summen -->
                <div class="clearfix">
                    <div id="total" class="row">
                        <div class="col-6 col-md-5 ms-auto">
                            <t t-call="account.document_tax_totals">
                                <t t-set="tax_totals" t-value="o.tax_totals"/>
                                <t t-set="currency" t-value="o.currency_id"/>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- Bankverbindung (nur fuer out_invoice posted) -->
                <div t-if="o.move_type == 'out_invoice' and o.state == 'posted'" class="mt-3">
                    <div>Wir danken für Ihr Vertrauen und ersuchen um Überweisung des ausgewiesenen Rechnungsbetrages innerhalb der oben angegebenen Zahlungsfrist auf nachstehend angeführtes Konto:</div>
                    <div class="mt-2">
                        <table class="table table-sm table-borderless" style="width:auto;">
                            <tr><td class="py-0 pe-3">Bankinstitut</td><td class="py-0"><span t-field="o.partner_bank_id.bank_id.name"/></td></tr>
                            <tr><td class="py-0 pe-3">IBAN</td><td class="py-0"><span t-field="o.partner_bank_id.acc_number"/></td></tr>
                            <tr><td class="py-0 pe-3">BIC</td><td class="py-0"><span t-field="o.partner_bank_id.bank_id.bic"/></td></tr>
                        </table>
                    </div>
                </div>

                <!-- Notizen / Valorisierung / Steuerhinweis -->
                <div t-if="o.narration" class="mt-3"><span t-field="o.narration"/></div>
                <div t-if="o.valorisierung_id" class="mt-2"><span t-field="o.valorisierung_id.description"/></div>
                <div t-if="o.notice" class="mt-2"><span t-field="o.notice"/></div>
                <div t-if="o.fiscal_position_id and o.fiscal_position_id.note" class="mt-2">
                    <strong>Steuerzuordnungshinweis:</strong>
                    <span t-field="o.fiscal_position_id.note"/>
                </div>

                <div class="mt-3">Ihr Team der IT-Kommunal GmbH<br/>www.it-kommunal.at</div>
                <div class="oe_structure"/>
            </div>
        </t>
    </template>

    <template id="report_itk_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="itk_reports.report_itk_invoice_document" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>

    <template id="report_itk_invoice_with_payments">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="itk_reports.report_itk_invoice_document_with_payments" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>

    <template id="report_itk_invoice_document_with_payments" inherit_id="itk_reports.report_itk_invoice_document" primary="True">
        <xpath expr="//div[@id='total']/div" position="inside">
            <table class="table table-sm">
                <tr t-if="o.amount_residual != o.amount_total">
                    <td><strong>Offener Betrag</strong></td>
                    <td class="text-end">
                        <span t-field="o.amount_residual" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                    </td>
                </tr>
            </table>
        </xpath>
    </template>

</odoo>
