<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_itk_invoice_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context({'lang':o.partner_id.lang})"/>

            <style>
* {
  box-sizing: border-box;
}
.column70 {
  float: left;
  width: 70%;
  padding-right: 5px;
  vertical-align: top;
  text-align: left;
  background-color: transparent;
}
.column30 {
  float: left;
  width: 30%;
  padding-right: 5px;
  vertical-align: top;
  text-align: left;
  background-color: transparent;
}
.row:after {
  content: "";
  display: table;
  clear: both;
}
            </style>

            <div class="page">
                <form>
                    <div class="container" style="line-height: 50%;padding-bottom:3em;padding-top:5em">

                        <div class="row" style="padding-bottom:1em; font-size:15px;padding-top:4em;">
                            <div class="col-10 small first-page text-start" name="company_address">
                                <u>
                                    <span t-field="o.company_id.partner_id.name"/>
                                    <font color="#000000">,</font>
                                    <span t-field="o.company_id.partner_id.zip"/>
                                    <span t-field="o.company_id.partner_id.city"/>
                                    <font color="#000000">,</font>
                                    <span t-field="o.company_id.partner_id.street"/>
                                </u>
                            </div>
                        </div>


                        <div class="row" style="padding-bottom:1em;padding-top:1em;">
                            <div class="col-9 text-start">
                                <table style="text-align: left; width: 60%; height: 36px; font-size: 16px;" border="1" cellpadding="2" cellspacing="2">
                                    <tbody>
                                        <tr>
                                            <td style="vertical-align: top;">
                                                <t t-esc="o.partner_id.parent_id.name"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="vertical-align: top;">
                                                <t t-esc="o.partner_id.community_salutation"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="vertical-align: top;">
                                                <span t-if="o.partner_id.attention_of">Zu Handen <br/></span>
                                                <t t-esc="o.partner_id.attention_of"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="vertical-align: top;">
                                                <t t-esc="o.partner_id.street"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="vertical-align: top;">
                                                <t t-esc="o.partner_id.street2"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="vertical-align: top;">
                                                <t t-esc="o.partner_id.zip"/>
                                                <t t-esc="o.partner_id.city"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <div class="row mt-3">
                                <div class="col-9 text-start"/>
                                <div class="col-1">
                                    <ul class="list-inline pagenumber float-end text-end">
                                        <li>
                                            <strong>
                                                <span class="page"/>
                                            </strong>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
                <div class="container" style="line-height: 50%;padding-bottom:1em;padding-top:1em">
                    <div class="row mt-3">
                        <div class="col-6 text-start"/>
                        <div class="col-6 float-end text-end">
                            <div style=" font-size: 16px;">
                                <strong>
                                    <span t-field="o.invoice_date" t-options='{"format": "dd.MM.yyyy"}'/>
                                </strong>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-9 text-start"/>
                        <div class="col-1">
                            <ul class="list-inline pagenumber float-end text-end">
                                <li>
                                    <strong>
                                        <span class="page"/>
                                    </strong>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div style="font-size: 16px;">
                        <strong>
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">
                                Rechnung
                            </span>
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">
                                Rechnungsentwurf
                            </span>
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Storno
                                Rechnung
                            </span>
                            <span t-if="o.move_type == 'out_refund'">Gutschrift</span>
                            <span t-if="o.move_type == 'in_refund'">Lieferanten Gutschrift</span>
                            <span t-if="o.move_type == 'in_invoice'">Eingangsrechnung</span>
                            <span t-field="o.name"/>
                        </strong>
                    </div>

                    <div class="container" style="line-height: 50%;padding-bottom:1em;padding-top:5em">
                        <div class="column70">
                            <table style="max-width: 100%; font-size: 16px;" cellpadding="2" border="0">
                                <colgroup>
                                    <col style="width: 10%;" span="1"/>
                                    <col style="max-width: 90%;" span="1"/>
                                </colgroup>
                                <tbody>
                                    <tr>
                                        <td><strong>Nutzungsvereinbarung:</strong></td>
                                        <td style="padding-left: 5px; text-align: left;">
                                            <span t-field="o.sale_order_confirmation_date" t-options='{"format": "dd.MM.yyyy"}'/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><strong>Projekt:</strong></td>
                                        <td style="padding-left: 5px; text-align: left;">
                                            <t t-esc="o.projectcategory_id.name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><strong>Leistungszeitraum:</strong></td>
                                        <td style="padding-left: 5px; text-align: left;">
                                            <t t-esc="o.sale_order_benefit_period"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="column30" style="">
                            <table style="width: 100%;  font-size: 16px;" border="0">
                                <colgroup>
                                    <col style="width: 10%;" span="1"/>
                                    <col style="max-width: 90%;" span="1"/>
                                </colgroup>
                                <tbody>
                                    <tr>
                                        <td> <strong>Zahlung:</strong></td>
                                        <td style="padding-left: 5px; text-align: left;">
                                            <t t-esc="o.invoice_payment_term_id.name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><strong>Bearbeiter/in:</strong></td>
                                        <td style="padding-left: 5px; text-align: left;">
                                            <t t-esc="o.user_id.name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><strong>Währung:</strong></td>
                                        <td style="padding-left: 5px; text-align: left;">
                                            <t t-esc="o.currency_id.name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><strong>Ihre UID-Nr.:</strong></td>
                                        <td style="padding-left: 5px; text-align: left;">
                                            <t t-esc="o.partner_id.vat"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <t t-set="display_discount" t-value="any([l.discount for l in o.invoice_line_ids])"/>
                <table name="invoice_line_table" width="100%" style="font-size: 16px;">
                    <thead>
                        <tr>
                            <th style="font-weight: bold; border-bottom: 1px solid black; background-color:#bbbbbb;padding-left:5px;">
                                Pos
                            </th>
                            <th style="font-weight: bold; border-bottom: 1px solid black; background-color:#bbbbbb;padding-left:5px;">
                                Leistungsgegenstand
                            </th>
                            <th class="text-end" style="font-weight: bold; border-bottom: 1px solid black; background-color:#bbbbbb;padding-left:5px;">
                                Menge
                            </th>
                            <th class="text-end" style="font-weight: bold; border-bottom: 1px solid black; background-color:#bbbbbb;padding-left:5px;">
                                Einzelpreis
                            </th>
                            <th class="text-end" style="font-weight: bold; border-bottom: 1px solid black; background-color:#bbbbbb;padding-left:5px;padding-right:5px;">
                                Gesamtpreis
                            </th>
                        </tr>
                    </thead>
                    <tbody class="invoice_tbody">
                        <tr t-foreach="o.invoice_line_ids" t-as="l" style="border-bottom:1em solid #ffffff; border-top:1em solid #ffffff;">
                            <td style="padding-left:5px;">
                                <span t-field="l.number"/>
                            </td>
                            <td style="padding-left:5px;">
                                <span t-field="l.name"/>
                            </td>
                            <td class="text-end" style="padding-left:5px;padding-right:5px;">
                                <span t-field="l.quantity"/>
                            </td>
                            <td class="text-end" style="padding-left:5px;padding-right:5px;">
                                <span t-field="l.price_unit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                            <td class="text-end" id="subtotal" style="padding-left:5px;padding-right:5px;">
                                <span t-field="l.price_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="clearfix">
                    <div id="total" class="row">
                        <div class="col-5 ms-auto">
                            <t t-call="account.document_tax_totals">
                                <t t-set="tax_totals" t-value="o.tax_totals"/>
                                <t t-set="currency" t-value="o.currency_id"/>
                            </t>
                        </div>
                    </div>
                </div>
                <div style="font-size: 16px;">
                    <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">
                        Wir danken für Ihr Vertrauen und ersuchen um Überweisung des ausgewiesenen Rechnungsbetrages
                        innerhalb der oben angegebenen Zahlungsfrist auf nachstehend angeführtes Konto:
                    </span>
                    <span t-if="o.move_type == 'in_refund'">---</span>
                    <span t-if="o.move_type == 'in_invoice'">---</span>
                </div>
                <div style="padding-top:2em"/>
                <table width="50%" style="font-size: 16px;">
                    <tr>
                        <td width="15%">
                            Bankinstitut
                        </td>
                        <td width="5%">:</td>
                        <td width="55%">
                            <span t-field="o.partner_bank_id.bank_id.name"/>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            IBAN
                        </td>
                        <td>:</td>
                        <td>
                            <span t-field="o.partner_bank_id.acc_number"/>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            BIC
                        </td>
                        <td>:</td>
                        <td>
                            <span t-field="o.partner_bank_id.bank_id.bic"/>
                        </td>
                    </tr>
                </table>
                <div style="padding-top:3em;font-size: 16px;"/>
                <div style="font-size: 16px;">
                    <p t-if="o.narration">
                        <span t-field="o.narration"/>
                    </p>
                    <p t-if="o.valorisierung_id">
                        <span t-field="o.valorisierung_id.description"/>
                    </p>
                    <p t-if="o.notice">
                        <span t-field="o.notice"/>
                    </p>
                    <p t-if="o.fiscal_position_id.note">
                        <strong>Steuerzuordnungshinweis:</strong>
                        <span t-field="o.fiscal_position_id.note"/>
                    </p>
                    <div style="visibility: hidden; display:inline;" name="invoice_address" class="col-5 offset-7">
                        <address t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'/>
                        <div t-if="o.partner_id.vat" class="mt-3">
                            <t t-esc="o.company_id.country_id.vat_label or 'TIN'"/>:
                            <span t-field="o.partner_id.vat"/>
                        </div>
                    </div>
                    <div style="padding-top:3em"/>
                    <div>
                        <span>
                            Ihr Team der IT-Kommunal GmbH
                            <br/>
                            <br/>
                            www.it-kommunal.at
                        </span>
                    </div>
                </div>
                <div class="oe_structure"/>
            </div>
        </t>
    </template>

    <template id="report_itk_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="itk_reports.report_itk_invoice_document" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>


    <!-- TODO: In Odoo 11 war dieser Report nicht aktiv (keine report-action). Die alte
         Methode _get_payments_vals() existiert in Odoo 18 nicht mehr. Struktur wird 1:1
         erhalten; die Zahlungsaufstellung ist auf Odoo-18-Felder (amount_residual)
         reduziert. Bei Bedarf voll implementieren (matched_payment_ids). -->
    <template id="report_itk_invoice_with_payments">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="itk_reports.report_itk_invoice_document_with_payments" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>

    <template id="report_itk_invoice_document_with_payments" inherit_id="report_itk_invoice_document" primary="True">
        <xpath expr="//div[@id='total']/div" position="inside">
            <table class="table table-sm">
                <tr t-if="o.amount_residual != o.amount_total">
                    <td>
                        <strong>Offener Betrag</strong>
                    </td>
                    <td class="text-end">
                        <span t-field="o.amount_residual" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                    </td>
                </tr>
            </table>
        </xpath>
    </template>

</odoo>
