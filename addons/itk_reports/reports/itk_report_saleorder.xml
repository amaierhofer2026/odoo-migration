<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_itk_saleorder_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context({'lang':doc.partner_id.lang})"/>
            <div class="page" style="font-size: 13px;">

                <!-- Adresse + Datum -->
                <div class="row mt-3">
                    <div class="col-7">
                        <div><span t-field="doc.partner_id.community_salutation"/></div>
                        <div t-if="doc.sale_contact_id.attention_of">Zu Handen <t t-esc="doc.sale_contact_id.attention_of"/></div>
                        <div><span t-field="doc.partner_id.street"/></div>
                        <div t-if="doc.partner_id.street2"><span t-field="doc.partner_id.street2"/></div>
                        <div>
                            <span t-field="doc.partner_id.zip"/>
                            <span t-field="doc.partner_id.city"/>
                        </div>
                    </div>
                    <div class="col-5 text-end">
                        <strong><span t-field="doc.date_order" t-options='{"format": "dd.MM.yyyy"}'/></strong>
                    </div>
                </div>

                <!-- Titel: Angebot / Auftrag / Proforma -->
                <h4 class="mt-4">
                    <t t-if="not is_pro_forma">
                        <span t-if="doc.state not in ['draft','sent']">Auftrag </span>
                        <span t-if="doc.state in ['draft','sent']">Angebot </span>
                    </t>
                    <t t-if="is_pro_forma"><span>Proformarechnung </span></t>
                    <span t-field="doc.name"/>
                </h4>

                <!-- Info-Block rechts (Zahlung / Bearbeiter / Waehrung / UID) -->
                <div class="row mt-2">
                    <div class="col-6"/>
                    <div class="col-6">
                        <table class="table table-sm table-borderless mb-0">
                            <tr>
                                <td class="py-0"><strong>Zahlung:</strong></td>
                                <td class="py-0"><t t-esc="doc.payment_term_id.name"/></td>
                            </tr>
                            <tr>
                                <td class="py-0"><strong>Bearbeiter/in:</strong></td>
                                <td class="py-0"><t t-esc="doc.user_id.name"/></td>
                            </tr>
                            <tr>
                                <td class="py-0"><strong>Währung:</strong></td>
                                <td class="py-0"><t t-esc="doc.currency_id.name"/></td>
                            </tr>
                            <tr>
                                <td class="py-0"><strong>Ihre UID-Nr.:</strong></td>
                                <td class="py-0"><t t-esc="doc.partner_id.vat"/></td>
                            </tr>
                        </table>
                    </div>
                </div>

                <!-- Einleitungstext -->
                <t t-if="not is_pro_forma">
                    <div class="mt-4">
                        <span t-if="doc.state not in ['draft','sent']">Hiermit bestätigen wir die Beauftragung der Leistungen gemäß Angebot.</span>
                        <span t-if="doc.state in ['draft','sent']">Folgend dürfen wir Ihnen die angefragte und abgestimmte Leistung anbieten:</span>
                    </div>
                </t>

                <!-- Positionstabelle -->
                <t t-set="display_discount" t-value="any([l.discount for l in doc.order_line])"/>
                <table class="table table-sm mt-3">
                    <thead>
                        <tr>
                            <th class="text-start" style="background-color:#bbbbbb;">Pos</th>
                            <th class="text-start" style="background-color:#bbbbbb;">Leistungsgegenstand</th>
                            <th class="text-end" style="background-color:#bbbbbb;">Menge</th>
                            <th class="text-end" style="background-color:#bbbbbb;">Einzelpreis</th>
                            <th t-if="display_discount" class="text-end" groups="sale.group_discount_per_so_line" style="background-color:#bbbbbb;">Rabatt</th>
                            <th class="text-end" style="background-color:#bbbbbb;">Gesamtpreis</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.order_line" t-as="l">
                            <td><span t-field="l.number"/></td>
                            <td><span t-field="l.name"/></td>
                            <td class="text-end">
                                <span t-field="l.product_uom_qty"/>
                                <span t-field="l.product_uom"/>
                            </td>
                            <td class="text-end">
                                <span t-field="l.price_unit" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                            </td>
                            <td t-if="display_discount" class="text-end" groups="sale.group_discount_per_so_line">
                                <span t-field="l.discount"/>%
                            </td>
                            <td class="text-end">
                                <span t-field="l.price_subtotal" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <!-- Summen (Netto / Steuer / Gesamt) -->
                <div class="clearfix">
                    <div id="total" class="row">
                        <div class="col-6 col-md-5 ms-auto">
                            <t t-call="account.document_tax_totals">
                                <t t-set="tax_totals" t-value="doc.tax_totals"/>
                                <t t-set="currency" t-value="doc.currency_id"/>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- Schlusstext -->
                <t t-if="not is_pro_forma">
                    <div class="mt-3">
                        <span t-if="doc.state not in ['draft','sent']">Wir bedanken uns für Ihre Beauftragung und sichern Ihnen die partnerschaftliche Ausführung der Leistungen zu.</span>
                        <span t-if="doc.state in ['draft','sent']">Über eine Beauftragung und die Möglichkeit zur Durchführung würden wir uns sehr freuen und können Ihnen bereits heute eine hochwertige und partnerschaftliche Umsetzung garantieren.</span>
                    </div>
                </t>
                <div class="mt-3"><span t-field="doc.note"/></div>
                <p t-if="doc.payment_term_id.note" class="mt-2">
                    <span t-field="doc.payment_term_id.note"/>
                </p>
                <p id="fiscal_position_remark" t-if="doc.fiscal_position_id and doc.fiscal_position_id.note" class="mt-2">
                    <strong>Steuerzuordnungshinweis:</strong>
                    <span t-field="doc.fiscal_position_id.note"/>
                </p>
                <div class="oe_structure"/>
            </div>
        </t>
    </template>

    <template id="report_itk_saleorder">
        <t t-call="web.html_container">
            <t t-set="is_pro_forma" t-value="False"/>
            <t t-foreach="docs" t-as="doc">
                <t t-call="itk_reports.report_itk_saleorder_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

    <template id="report_itk_saleorder_proforma">
        <t t-call="web.html_container">
            <t t-set="is_pro_forma" t-value="True"/>
            <t t-foreach="docs" t-as="doc">
                <t t-call="itk_reports.report_itk_saleorder_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

</odoo>
