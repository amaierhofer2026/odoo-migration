<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_itk_saleorder_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context({'lang':doc.partner_id.lang})"/>

            <style>
* {
  box-sizing: border-box;
}
.column70 {
  float: left;
  width: 70%;
  padding-right: 5px;
  vertical-align: top;
  text-align: left;
  background-color: transparent;
}
.column30 {
  float: left;
  width: 30%;
  padding-right: 5px;
  vertical-align: top;
  text-align: left;
  background-color: transparent;
}
.row:after {
  content: "";
  display: table;
  clear: both;
}
            </style>

            <div class="page">
                <form>
                    <div class="container" style="line-height: 50%;padding-bottom:3em;padding-top:10em">

                        <div class="row " style="padding-bottom:1em; font-size:15px; padding-top:3em;">
                            <div class="col-10 small first-page" name="company_address">
                                <u>
                                    <span t-field="doc.company_id.partner_id.name"/>
                                    <font color="#000000">,</font>
                                    <span t-field="doc.company_id.partner_id.zip"/>
                                    <span t-field="doc.company_id.partner_id.city"/>
                                    <font color="#000000">,</font>
                                    <span t-field="doc.company_id.partner_id.street"/>
                                </u>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-9 text-start;font-size: 16px;">
                                <table style="text-align: left; width: 60%; height: 36px; font-size: 16px;" border="1" cellpadding="2" cellspacing="2">
                                    <tbody>
                                        <tr>
                                            <td style="vertical-align: top;">
                                                <t t-esc="doc.partner_id.community_salutation"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="vertical-align: top;">
                                                <span t-if="doc.sale_contact_id.attention_of">Zu Handen </span>
                                                <t t-esc="doc.sale_contact_id.attention_of"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="vertical-align: top;">
                                                <t t-esc="doc.partner_id.street"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="vertical-align: top;">
                                                <t t-esc="doc.partner_id.street2"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="vertical-align: top;">
                                                <t t-esc="doc.partner_id.zip"/>
                                                <t t-esc="doc.partner_id.city"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-9 text-start"/>
                            <div class="col-1">
                                <ul class="list-inline pagenumber float-end text-end">
                                    <li>
                                        <strong>
                                            <span class="page"/>
                                        </strong>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </form>
                <div class="container" style="line-height: 50%;padding-bottom:1em;padding-top:1em">
                    <div class="row mt-3">
                        <div class="col-6 text-start"/>
                        <div class="col-6 float-end text-end">
                            <div style="font-size: 16px;">
                                <strong>
                                    <span t-field="doc.date_order" t-options='{"format": "dd.MM.yyyy"}'/>
                                </strong>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-9 text-start"/>
                        <div class="col-1">
                            <ul class="list-inline pagenumber float-end text-end">
                                <li>
                                    <strong>
                                        <span class="page"/>
                                    </strong>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div style="font-size: 16px;">
                    <strong>
                        <t t-if="not is_pro_forma">
                            <span t-if="doc.state not in ['draft','sent']">Auftrag</span>
                            <span t-if="doc.state in ['draft','sent']">Angebot</span>
                        </t>
                        <t t-if="is_pro_forma">
                            <span>Proformarechnung</span>
                        </t>
                        <span t-field="doc.name"/>
                    </strong>
                </div>

                <div class="container" style="line-height: 50%;padding-bottom:1em;padding-top:5em">
                    <div class="column70">
                        <table style="max-width: 100%; font-size: 16px;" cellpadding="2" border="0">
                            <colgroup>
                                <col style="width: 10%;" span="1"/>
                                <col style="max-width: 90%;" span="1"/>
                            </colgroup>
                            <tbody>
                                <tr style="opacity: 0.0;">
                                    <td><strong>e </strong></td>
                                    <td style="padding-left: 5px; text-align: left;"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="column30" style="">
                        <table style="width: 100%;  font-size: 16px;" border="0">
                            <colgroup>
                                <col style="width: 10%;" span="1"/>
                                <col style="max-width: 90%;" span="1"/>
                            </colgroup>
                            <tbody>
                                <tr>
                                    <td> <strong>Zahlung:</strong></td>
                                    <td style="padding-left: 5px; text-align: left;">
                                        <t t-esc="doc.payment_term_id.name"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Bearbeiter/in:</strong></td>
                                    <td style="padding-left: 5px; text-align: left;">
                                        <t t-esc="doc.user_id.name"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Währung:</strong></td>
                                    <td style="padding-left: 5px; text-align: left;">
                                        <t t-esc="doc.currency_id.name"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Ihre UID-Nr.:</strong></td>
                                    <td style="padding-left: 5px; text-align: left;">
                                        <t t-esc="doc.partner_id.vat"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div style="padding-bottom:1em; font-size: 16px;"/>
                <t t-if="not is_pro_forma">
                    <div style="font-size: 16px;">
                        <span t-if="doc.state not in ['draft','sent']">Hiermit bestätigen wir die Beauftragung der
                        Leistungen gemäß Angebot.
                        </span>
                        <span t-if="doc.state in ['draft','sent']">Folgend dürfen wir Ihnen die angefragte und
                        abgestimmte Leistung anbieten:
                        </span>
                    </div>
                </t>
                <div style="padding-bottom: 1em"/>
                <t t-set="display_discount" t-value="any([l.discount for l in doc.order_line])"/>
                <table style="width:100%">
                    <thead class="active">
                        <tr>
                            <th style="font-weight: bold; border-bottom: 1px solid black; background-color:#bbbbbb;padding-left:5px;">
                                Pos
                            </th>
                            <th style="font-weight: bold; border-bottom: 1px solid black; background-color:#bbbbbb;padding-left:5px;">
                                Leistungsgegenstand
                            </th>
                            <th class="text-end" style="font-weight: bold; border-bottom: 1px solid black; background-color:#bbbbbb;padding-left:5px;">
                                Menge
                            </th>
                            <th class="text-end" style="font-weight: bold; border-bottom: 1px solid black; background-color:#bbbbbb;padding-left:5px;">
                                Einzelpreis
                            </th>
                            <th t-if="display_discount" class="text-end" groups="sale.group_discount_per_so_line" style="font-weight: bold; border-bottom: 1px solid black; background-color:#bbbbbb;">
                                Rabatt
                            </th>
                            <th class="text-end" style="font-weight: bold; border-bottom: 1px solid black; background-color:#bbbbbb;padding-left:5px;padding-right:5px;">
                                Gesamtpreis
                            </th>
                        </tr>
                    </thead>
                    <tbody class="sale_tbody" style="font-size: 16px;">
                        <tr t-foreach="doc.order_line" t-as="l" style="font-size: 16px; border-bottom:1em solid #ffffff; border-top:1em solid #ffffff;">
                            <td style="padding-left:5px;">
                                <span t-field="l.number"/>
                            </td>
                            <td style="padding-left:5px;">
                                <span t-field="l.name"/>
                            </td>
                            <td class="text-end" style="padding-left:5px;padding-right:5px;">
                                <span t-field="l.product_uom_qty"/>
                                <span t-field="l.product_uom"/>
                            </td>
                            <td class="text-end" style="padding-left:5px;padding-right:5px;">
                                <span t-field="l.price_unit" t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}'/>
                            </td>
                            <td t-if="display_discount" class="text-end" groups="sale.group_discount_per_so_line">
                                <span t-field="l.discount"/>
                                <span>%</span>
                            </td>
                            <td class="text-end" style="padding-left:5px;padding-right:5px;">
                                <span t-field="l.price_subtotal" t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}'/>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="clearfix">
                    <div id="total" class="row" name="total" style="font-size: 16px;">
                        <div class="col-5 ms-auto">
                            <t t-call="account.document_tax_totals">
                                <t t-set="tax_totals" t-value="doc.tax_totals"/>
                                <t t-set="currency" t-value="doc.currency_id"/>
                            </t>
                        </div>
                    </div>
                </div>
                <t t-if="not is_pro_forma">
                    <div style="font-size: 16px;">
                        <span t-if="doc.state not in ['draft','sent']">Wir bedanken uns für Ihre Beauftragung und
                        sichern Ihnen
                        die partnerschaftliche Ausführung der Leistungen zu.
                        </span>
                        <span t-if="doc.state in ['draft','sent']">Über eine Beauftragung und die Möglichkeit zur
                        Durchführung
                        würden wir uns sehr freuen und können Ihnen bereits heute eine hochwertige und
                        partnerschaftliche
                        Umsetzung garantieren.
                        </span>
                    </div>
                </t>
                <div style="padding-top:3em"/>
                <p t-field="doc.note"/>
                <p t-if="doc.payment_term_id.note">
                    <span t-field="doc.payment_term_id.note"/>
                </p>
                <p id="fiscal_position_remark" t-if="doc.fiscal_position_id and doc.fiscal_position_id.note">
                    <strong>Steuerzuordnungshinweis:</strong>
                    <span t-field="doc.fiscal_position_id.note"/>
                </p>
                <div class="oe_structure"/>
            </div>
        </t>
    </template>

    <template id="report_itk_saleorder">
        <t t-call="web.html_container">
            <t t-set="is_pro_forma" t-value="False"/>
            <t t-foreach="docs" t-as="doc">
                <t t-call="itk_reports.report_itk_saleorder_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

    <template id="report_itk_saleorder_proforma">
        <t t-call="web.html_container">
            <t t-set="is_pro_forma" t-value="True"/>
            <t t-foreach="docs" t-as="doc">
                <t t-call="itk_reports.report_itk_saleorder_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

</odoo>
