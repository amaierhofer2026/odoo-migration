# Vorlage fuer die gitignored .env im Repo-Root (C:\Odoo-Test\.env)
# 1. cp .env.example .env
# 2. Werte eintragen (NIE committen - .env ist gitignored)
# 3. LOKALER Docker-Stack: POSTGRES_PASSWORD MUSS dem Passwort des bestehenden
#    Named Volumes odoo18_pgdata entsprechen (Postgres setzt das Passwort nur
#    beim ERSTEN Start; ein abweichender Wert wuerde den naechsten Stack-Restart
#    brechen). Die lokale Datenbank wird dabei NICHT veraendert.
#    Aktueller lokaler Wert (09/2026): odoo (Volume vom 12.08.2026)

# --- Docker-Compose (lokaler Stack) ---
POSTGRES_PASSWORD=<Passwort des bestehenden lokalen Volumes>

# --- Projektskripte (scripts/test_migration_contacts.py, validate_contacts.py) ---
# Odoo 11 (historisch - VM ist dekommissioniert, Zugangsdaten nur noch fuer Skript-Vollstaendigkeit)
ODOO11_URL=https://93.189.28.204
ODOO11_DB=ITK_V1_a
ODOO11_USER=anna.maierhofer@it-kommunal.at
ODOO11_PWD=<historisch, nicht mehr aktiv>

# Odoo 18 Testumgebung (lokal / VM)
ODOO18_URL=http://localhost:8069
ODOO18_DB=odoo18_test
